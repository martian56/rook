// The .agents folder: rook's shared entry point for skills, subagents,
// commands, and settings, following the cross-agent convention (the same
// layout other coding agents read). A project .agents sits in the working
// directory; a global one lives at ~/.agents. Project entries shadow global
// ones of the same name.
//
// Discovery is the only part that touches the environment; everything else
// takes the roots as a parameter, so the loaders built on top (and the
// tests) can work over any list of directories.

import std.string
from std.sync import Mutex, mutex
from std.env import get_env, has_env
from std.fs import exists, is_dir, list_dir
from "../plugins/model" import plugin_roots

// The discovered roots the loaders read, highest precedence first: the
// project's .agents, then each installed plugin, then the global .agents.
// So a project entry shadows a plugin's, which shadows the global one. Any
// may be absent.
fun roots() -> list[str] {
    return compose_roots(project_root(), _cached_plugin_roots(), global_root())
}

// The plugin roots, cached for the process. Only this part of roots() is cached:
// it reads and parses every plugin manifest, which is the cost that multiplied
// across a turn's rounds, tool checks, and hook fires. The .agents discovery
// (project_root/global_root) stays fresh, because it is cheap stat calls and
// the working directory's .agents can appear mid-run (the behavior evals create
// one). Invalidated when a plugin is installed, removed, or updated. Locked
// because roots() is read from both the UI thread and the turn goroutine.
class PluginRootsCache {
    lock: Mutex
    ready: bool
    roots: list[str]
}

let PLUGIN_ROOTS_CACHE: PluginRootsCache = _new_plugin_roots_cache()

fun _new_plugin_roots_cache() -> PluginRootsCache {
    let roots: list[str] = []
    return PluginRootsCache(lock: mutex(), ready: false, roots: roots)
}

fun _cached_plugin_roots() -> list[str] {
    PLUGIN_ROOTS_CACHE.lock.lock()
    if not PLUGIN_ROOTS_CACHE.ready {
        PLUGIN_ROOTS_CACHE.roots = plugin_roots()
        PLUGIN_ROOTS_CACHE.ready = true
    }
    let out = PLUGIN_ROOTS_CACHE.roots
    PLUGIN_ROOTS_CACHE.lock.unlock()
    return out
}

// Drop the cached plugin roots so the next call rediscovers them, after a
// plugin change.
fun invalidate_roots() {
    PLUGIN_ROOTS_CACHE.lock.lock()
    PLUGIN_ROOTS_CACHE.ready = false
    PLUGIN_ROOTS_CACHE.lock.unlock()
    return
}

// Assemble the root order from its three parts, skipping empties. Pure, so
// the precedence is tested without touching the filesystem.
fun compose_roots(project: str, plugins: list[str], global: str) -> list[str] {
    let out: list[str] = []
    if project != "" {
        out.push(project)
    }
    var i = 0
    while i < plugins.len() {
        if plugins[i] != "" {
            out.push(plugins[i])
        }
        i = i + 1
    }
    if global != "" {
        out.push(global)
    }
    return out
}

// The project's .agents folder, "" when the working directory has none.
fun project_root() -> str {
    if is_dir(".agents") {
        return ".agents"
    }
    return ""
}

// The global ~/.agents folder, "" when absent.
fun global_root() -> str {
    let h = _home()
    if h != "" and is_dir("${h}/.agents") {
        return "${h}/.agents"
    }
    return ""
}

// The entry names inside `sub` across the roots, in precedence order and
// deduped: a project entry shadows a global entry with the same name.
fun merged_names(rs: list[str], sub: str) -> list[str] {
    let out: list[str] = []
    var r = 0
    while r < rs.len() {
        let names = _names(rs[r], sub)
        var i = 0
        while i < names.len() {
            if not _has(out, names[i]) {
                out.push(names[i])
            }
            i = i + 1
        }
        r = r + 1
    }
    return out
}

// The full path of `sub`/`name` under the first root that has it, "" when
// no root does. The lookup half of merged_names.
fun path_of(rs: list[str], sub: str, name: str) -> str {
    var r = 0
    while r < rs.len() {
        let p = "${rs[r]}/${sub}/${name}"
        if exists(p) {
            return p
        }
        r = r + 1
    }
    return ""
}

// The full path of `rel` under the first root that has it, "" when none
// does. For single files like settings.json.
fun first_file(rs: list[str], rel: str) -> str {
    var r = 0
    while r < rs.len() {
        let p = "${rs[r]}/${rel}"
        if exists(p) {
            return p
        }
        r = r + 1
    }
    return ""
}

// Every root's copy of `rel` that exists, in precedence order. For loaders
// that merge (settings): iterate from the end so the project copy, first in
// the list, is applied last and wins.
fun existing(rs: list[str], rel: str) -> list[str] {
    let out: list[str] = []
    var r = 0
    while r < rs.len() {
        let p = "${rs[r]}/${rel}"
        if exists(p) {
            out.push(p)
        }
        r = r + 1
    }
    return out
}

fun _names(root: str, sub: str) -> list[str] {
    let empty: list[str] = []
    return match list_dir("${root}/${sub}") {
        case Ok(names) { names }
        case Err(e) { empty }
    }
}

fun _has(xs: list[str], x: str) -> bool {
    var i = 0
    while i < xs.len() {
        if xs[i] == x {
            return true
        }
        i = i + 1
    }
    return false
}

fun _home() -> str {
    if has_env("HOME") {
        let h = get_env("HOME")
        if h != "" {
            return h
        }
    }
    if has_env("USERPROFILE") {
        return get_env("USERPROFILE")
    }
    return ""
}
