// Structured ask_user options. The model-facing schema prefers an array of
// objects with a display label and optional stable value, while the parser
// keeps the old comma-separated string format working for now.

import std.string
from std.json import JsonValue, parse

class AskOption {
    label: str
    value: str
}

fun parse_ask_options(args_json: str) -> list[AskOption] {
    let out: list[AskOption] = []
    if args_json.trim() == "" {
        return out
    }
    match parse(args_json) {
        case Ok(j) {
            let options = _field(j, "options")
            match options {
                case Array(items) {
                    var i = 0
                    while i < items.len() {
                        let option = _option_from_json(items[i])
                        if option.label != "" {
                            out.push(option)
                        }
                        i = i + 1
                    }
                }
                case _ { _append_comma_options(_as_str(options), out) }
            }
        }
        case Err(e) {}
    }
    return out
}

fun option_labels(options: list[AskOption]) -> list[str] {
    let labels: list[str] = []
    var i = 0
    while i < options.len() {
        labels.push(options[i].label)
        i = i + 1
    }
    return labels
}

fun option_count_error(options: list[AskOption]) -> str {
    if options.len() < 2 or options.len() > 5 {
        return "error: ask_user needs two to five options"
    }
    return ""
}

fun _option_from_json(j: JsonValue) -> AskOption {
    var label = ""
    var value = ""
    match j {
        case Str(s) {
            label = s.trim()
            value = label
        }
        case Object(obj) {
            label = _as_str(_field(j, "label")).trim()
            value = _as_str(_field(j, "value")).trim()
            if label == "" {
                label = value
            }
            if value == "" {
                value = label
            }
        }
        case _ {}
    }
    return AskOption(label: label, value: value)
}

fun _append_comma_options(raw: str, out: list[AskOption]) {
    let parts = raw.split(",")
    var i = 0
    while i < parts.len() {
        let label = parts[i].trim()
        if label != "" {
            out.push(AskOption(label: label, value: label))
        }
        i = i + 1
    }
    return
}

fun _field(j: JsonValue, key: str) -> JsonValue {
    return match j.get(key) {
        case Some(v) { v }
        case None { JsonValue.Null }
    }
}

fun _as_str(j: JsonValue) -> str {
    return match j.as_string() {
        case Some(s) { s }
        case None { "" }
    }
}
