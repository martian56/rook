// Context compaction: when the conversation grows toward the model's context
// window, summarize the older turns into one compact note and keep the recent
// turns verbatim, so a long session neither overflows nor gets truncated
// blindly. The summary is produced by a one-off model call; if it fails, the
// conversation is left untouched rather than lost.
//
// The estimate, the split, and the rebuild are pure so they are tested
// directly; only the summarize call and the state swap touch the outside.

import std.string
from "github.com/martian56/aviary" import complete_stream
from "github.com/martian56/aviary/request" import CancelToken
from "github.com/martian56/aviary/request" import ChatRequest
from "github.com/martian56/aviary/message" import Message, Role
from "./state" import AgentState, DisplayEvent
from "../config/config" import context_window_override

// Keep this many recent user turns verbatim; summarize everything before.
let KEEP_TURNS: int = 4
let DEFAULT_WINDOW: int = 128000
// Compact once the estimate passes this percent of the window.
let COMPACT_RATIO_PCT: int = 70

let SUMMARY_SYSTEM: str = "You compress a coding assistant's conversation so it can continue with less context. Keep only what matters for continuing the work."
let SUMMARY_INSTRUCTION: str = "Summarize the conversation so far into a compact note. Keep: the user's goals and decisions, files created or changed and how, commands run and their outcomes, and anything still in progress or unresolved. Drop pleasantries and redundant detail. Write it as notes you can rely on to keep working."

// Check the running conversation and, if it is large enough, replace the
// older turns with a summary. Returns how many messages were summarized away
// (0 when nothing was compacted). Runs on the turn goroutine before the
// request is built.
fun maybe_compact(
    st: AgentState,
    model: str,
    api_key: str,
    base_url: str,
    overhead_chars: int,
) -> int {
    let msgs = st.messages()
    if not should_compact(msgs, model, overhead_chars) {
        return 0
    }
    // The turn's cancel token, so Esc lands during the summarization request
    // instead of waiting it out.
    return _compact_now(st, msgs, model, api_key, base_url, st.token())
}

// /compact: summarize regardless of how close to the window the conversation
// is, so the user can shed context on demand. Returns how many messages were
// folded into the summary, 0 when there is not enough history to fold. A
// fresh token, not the turn's: /compact runs between turns, and the last
// turn's token may already be canceled from an old Esc.
fun force_compact(st: AgentState, model: str, api_key: str, base_url: str) -> int {
    return _compact_now(st, st.messages(), model, api_key, base_url, CancelToken.new())
}

fun _compact_now(
    st: AgentState,
    msgs: list[Message],
    model: str,
    api_key: str,
    base_url: str,
    token: CancelToken,
) -> int {
    let split = split_index(msgs, KEEP_TURNS)
    if split < 0 {
        return 0
    }
    let old: list[Message] = []
    var i = 0
    while i < split {
        old.push(msgs[i])
        i = i + 1
    }
    let summary = summarize(old, model, api_key, base_url, token)
    if summary.trim() == "" {
        // A failed summary must not drop the conversation.
        return 0
    }
    st.replace_convo(rebuild(msgs, split, summary))
    return split
}

// A rough token estimate: about four characters per token, plus a little per
// message for the role and any tool-call arguments.
fun estimate_tokens(msgs: list[Message]) -> int {
    var chars = 0
    var i = 0
    while i < msgs.len() {
        chars = chars + msgs[i].content.length() + 8
        var j = 0
        while j < msgs[i].tool_calls.len() {
            chars = chars + msgs[i].tool_calls[j].arguments.length() + msgs[i].tool_calls[j].name.length()
            j = j + 1
        }
        i = i + 1
    }
    return chars / 4
}

// The context window for a model, by family, with a conservative default.
fun context_window(model: str) -> int {
    let configured = context_window_override()
    if configured > 0 {
        return configured
    }
    return family_window(model)
}

// The window for a model family. An unrecognized model gets DEFAULT_WINDOW;
// rook.json "context_window" corrects one rook does not know.
fun family_window(model: str) -> int {
    let m = model.to_lower()
    let table: list[(str, int)] = [
        ("gemini", 1000000),
        ("gpt-5", 400000),
        ("gpt-4.1", 1000000),
        ("claude", 200000),
        ("grok-4", 256000),
        ("grok-build", 256000),
        ("kimi-k", 256000),
        ("command-a", 256000),
        ("fugu", 200000),
        ("deepseek", 128000),
        ("mistral", 128000),
        ("ministral", 128000),
        ("sonar", 128000),
        ("gpt-4o", 128000),
        ("o1", 128000),
        ("o3", 128000),
        ("gpt-4-turbo", 128000),
    ]
    for (needle, window) in table {
        if m.contains(needle) {
            return window
        }
    }
    return DEFAULT_WINDOW
}

// Whether a request would be large enough to compact first. `overhead_chars`
// is what the request adds around the conversation: the system prompt and
// the tool schemas.
fun should_compact(msgs: list[Message], model: str, overhead_chars: int) -> bool {
    let budget = (context_window(model) * COMPACT_RATIO_PCT) / 100
    return estimate_tokens(msgs) + overhead_chars / 4 > budget
}

// The index at which the last `keep_turns` user turns begin: everything
// before it is summarized, everything from it stays verbatim. A user turn is
// a User-role message (a tool result is a Tool-role message, not a boundary).
// Returns -1 when there are not enough turns to bother, so recent history is
// never summarized.
fun split_index(msgs: list[Message], keep_turns: int) -> int {
    let user_idx: list[int] = []
    var i = 0
    while i < msgs.len() {
        if _is_user(msgs[i]) {
            user_idx.push(i)
        }
        i = i + 1
    }
    if user_idx.len() <= keep_turns {
        return 0 - 1
    }
    let boundary = user_idx[user_idx.len() - keep_turns]
    if boundary < 2 {
        return 0 - 1
    }
    return boundary
}

// The conversation with [0, split) replaced by one summary message and the
// rest kept verbatim. Pure. The summary is a user message so it is a valid
// standalone start (a tool result would be orphaned).
fun rebuild(msgs: list[Message], split: int, summary: str) -> list[Message] {
    let out: list[Message] = []
    out.push(Message.user("[Earlier conversation, summarized to save context]\n\n${summary}"))
    var i = split
    while i < msgs.len() {
        out.push(msgs[i])
        i = i + 1
    }
    return out
}

// Flatten messages into a plain transcript for the summarizer, so the
// summarize request carries no tool-call structure of its own to keep valid.
fun flatten(msgs: list[Message]) -> str {
    var out = ""
    var i = 0
    while i < msgs.len() {
        let m = msgs[i]
        var body = m.content
        var j = 0
        while j < m.tool_calls.len() {
            if body != "" {
                body = body.concat(" ")
            }
            body = body.concat("[calls ${m.tool_calls[j].name}]")
            j = j + 1
        }
        if body.trim() != "" {
            if out != "" {
                out = out.concat("\n")
            }
            out = out.concat("${_role_label(m)}: ${body}")
        }
        i = i + 1
    }
    return out
}

fun summarize(
    old: list[Message],
    model: str,
    api_key: str,
    base_url: str,
    token: CancelToken,
) -> str {
    let transcript = flatten(old)
    if transcript.trim() == "" {
        return ""
    }
    var req = ChatRequest.new(model).system(SUMMARY_SYSTEM).user(
        "${SUMMARY_INSTRUCTION}\n\n${transcript}",
    )
    if api_key != "" {
        req = req.key(api_key)
    }
    if base_url != "" {
        req = req.base(base_url)
    }
    req = req.timeout(60000).cancelable(token)
    // Streamed with a discarding callback so the cancel token is checked at
    // every chunk; a canceled summary comes back partial and is discarded.
    return match complete_stream(req, _discard_delta) {
        case Ok(reply) { "" if reply.finish_reason == "canceled" else reply.content }
        case Err(e) { "" }
    }
}

fun _discard_delta(d: str) {
    return
}

fun _is_user(m: Message) -> bool {
    return match m.role {
        case User { true }
        case _ { false }
    }
}

fun _role_label(m: Message) -> str {
    return match m.role {
        case System { "SYSTEM" }
        case User { "USER" }
        case Assistant { "ASSISTANT" }
        case Tool { "TOOL(${m.name})" }
    }
}
