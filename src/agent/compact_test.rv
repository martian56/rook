import std.string
from std.test import assert_eq_str, assert_eq_int, assert_true
from "github.com/martian56/aviary/message" import Message
from "./compact" import (
    estimate_tokens,
    family_window,
    should_compact,
    split_index,
    rebuild,
    flatten,
)

fun test_estimate_tokens_is_chars_over_four() {
    // "abcd" is 4 chars plus 8 overhead = 12, /4 = 3.
    assert_eq_int(estimate_tokens([Message.user("abcd")]), 3)
}

fun test_context_window_by_family() {
    assert_eq_int(family_window("anthropic/claude-opus-4-8"), 200000)
    assert_eq_int(family_window("gpt-4o"), 128000)
    assert_eq_int(family_window("google/gemini-3.1-pro-preview"), 1000000)
    // The shipped flagships no longer fall through to the default.
    assert_eq_int(family_window("openai/gpt-5.6-sol"), 400000)
    assert_eq_int(family_window("xai/grok-4.5"), 256000)
    assert_eq_int(family_window("moonshot/kimi-k3"), 256000)
    assert_eq_int(family_window("cohere/command-a-plus-05-2026"), 256000)
    assert_eq_int(family_window("deepseek/deepseek-v4-pro"), 128000)
    // An unknown model gets the conservative default.
    assert_eq_int(family_window("some-new-model"), 128000)
}

fun test_request_overhead_counts_toward_compaction() {
    // ~320k chars is ~80k tokens: under 70% of 128k on its own, over it once
    // a large system prompt and tool schemas are added.
    let unit = _repeat("x", 1000)
    let msgs = [Message.user(_repeat(unit, 320))]
    assert_true(not should_compact(msgs, "deepseek/deepseek-v4-pro", 0))
    assert_true(should_compact(msgs, "deepseek/deepseek-v4-pro", 60000))
}

fun test_should_compact_only_when_large_and_is_model_aware() {
    let small = [Message.user("hello"), Message.assistant("hi")]
    assert_true(not should_compact(small, "gpt-4o", 0))

    // ~400k chars is ~100k tokens: over 70% of gpt-4o's 128k, under claude's.
    let unit = _repeat("x", 1000)
    let huge = [Message.user(_repeat(unit, 400))]
    assert_true(should_compact(huge, "gpt-4o", 0))
    assert_true(not should_compact(huge, "claude-opus-4", 0))
}

fun test_split_index_keeps_the_last_turns() {
    let convo = [
        Message.user("q1"),
        Message.assistant("a1"),
        Message.user("q2"),
        Message.assistant("a2"),
        Message.user("q3"),
        Message.assistant("a3"),
        Message.user("q4"),
        Message.assistant("a4"),
        Message.user("q5"),
        Message.assistant("a5"),
    ]
    // Five user turns, keep four: summarize up to the second turn (index 2).
    assert_eq_int(split_index(convo, 4), 2)
    // Too few turns to bother.
    assert_eq_int(split_index(convo, 5), 0 - 1)
    assert_eq_int(split_index(convo, 8), 0 - 1)
}

fun test_rebuild_replaces_old_with_a_summary() {
    let convo = [
        Message.user("q1"),
        Message.assistant("a1"),
        Message.user("q2"),
        Message.assistant("a2"),
    ]
    let out = rebuild(convo, 2, "did q1")
    // One summary message plus the two kept messages.
    assert_eq_int(out.len(), 3)
    assert_true(out[0].content.contains("did q1"))
    assert_true(out[0].content.contains("summarized"))
    // The recent messages are kept verbatim.
    assert_eq_str(out[1].content, "q2")
    assert_eq_str(out[2].content, "a2")
}

fun test_flatten_labels_roles() {
    let convo = [
        Message.user("hi"),
        Message.assistant("yo"),
        Message.tool_result("id", "grep", "match"),
    ]
    let text = flatten(convo)
    assert_true(text.contains("USER: hi"))
    assert_true(text.contains("ASSISTANT: yo"))
    assert_true(text.contains("TOOL(grep): match"))
}

fun _repeat(chunk: str, times: int) -> str {
    var out = ""
    var i = 0
    while i < times {
        out = out.concat(chunk)
        i = i + 1
    }
    return out
}
