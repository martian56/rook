// A subagent run: an isolated nested turn executed inside the parent turn's
// goroutine. The subagent gets its own message history, its own system
// prompt (the definition body), its own tool allowlist and round cap, and
// hands back only its final text, so nothing but the result enters the
// parent conversation. Display and approvals still flow through the parent
// AgentState: tool activity shows as "<agent> › tool(...)" rows, and a
// mutating call blocks on the same approval prompt as the parent's own.

import std.string
from "github.com/martian56/aviary" import complete_stream
from "github.com/martian56/aviary/request" import ChatRequest
from "github.com/martian56/aviary/message" import Message, ToolCall, ToolDef
from "./state" import AgentState, DisplayEvent
from "./session" import request_timeout_ms
from "../tools/registry" import tools, needs_approval, call_needs_approval, call_approval_detail, dispatch_cancelable, label
from "../tools/preview" import change_preview, append_preview
from "../tools/permissions" import Verdict, check_permission
from "../hooks/hooks" import run_pre_tool_hooks_for_agent, fire_hooks_for_agent
from "../agents/subagents" import Subagent
from "../config/config" import resolve_key, debug_log

let SUB_ROUNDS: int = 15

// The system prompt when a definition body is empty.
let DEFAULT_SUB_PROMPT: str = "You are a focused assistant working on one delegated task in the user's current directory. Use the available tools to complete it, then reply with a concise final answer; your reply is handed back to the agent that delegated to you."

// Run `agent` against `task` to completion and return its final text, or an
// "error: ..." string. Blocks the calling goroutine, which is the parent
// turn; the UI stays live because it only ever reads the shared state.
fun run_subagent(
    st: AgentState,
    id: str,
    agent: Subagent,
    task: str,
    model: str,
    api_key: str,
    base_url: str,
) -> str {
    var use_model = model
    var use_key = api_key
    if agent.model != "" {
        use_model = agent.model
        use_key = resolve_key(agent.model)
    }
    var prompt = agent.prompt
    if prompt.trim() == "" {
        prompt = DEFAULT_SUB_PROMPT
    }

    st.emit(DisplayEvent.AgentStarted(id, agent.name))
    var used = 0
    let history: list[Message] = [Message.user(task)]
    let allowed: list[str] = []
    var round = 0
    // Built once for the subagent's whole run, not rebuilt every round.
    let sub_tool_defs = tools()
    while round < SUB_ROUNDS {
        if st.interrupted() {
            st.emit(DisplayEvent.AgentFinished(id, agent.name, used))
            return "error: interrupted"
        }
        // Attach the turn's cancel token so Esc aborts the subagent's in-flight
        // request instead of the parent waiting out the full timeout.
        let req = _sub_request(
            use_model,
            prompt,
            history,
            use_key,
            base_url,
            agent.tools,
            st.plan(),
            sub_tool_defs,
        ).cancelable(st.token())

        var reply_text = ""
        var calls: list[ToolCall] = []
        var finish = ""
        var err = ""
        // Streamed with a discarding callback rather than buffered: the
        // buffered path cannot notice a cancel mid-request, so Esc would sit
        // dead for the whole reply. Streaming checks the token every chunk.
        match complete_stream(req, _discard_chunk) {
            case Ok(reply) {
                reply_text = reply.content
                calls = reply.tool_calls
                finish = reply.finish_reason
                st.add_usage(
                    reply.usage.prompt_tokens,
                    reply.usage.completion_tokens,
                    reply.usage.cache_read_tokens,
                    reply.usage.cache_write_tokens,
                )
            }
            case Err(e) {
                err = e.message
            }
        }
        if err != "" {
            debug_log("subagent ${agent.name} error model=${use_model}: ${err}")
            st.emit(DisplayEvent.AgentFinished(id, agent.name, used))
            return "error: ${err}"
        }
        if finish == "canceled" {
            st.emit(DisplayEvent.AgentFinished(id, agent.name, used))
            return "error: interrupted"
        }
        if calls.len() == 0 {
            st.emit(DisplayEvent.AgentFinished(id, agent.name, used))
            return reply_text
        }

        history.push(Message.assistant_calls(reply_text, calls))
        var i = 0
        while i < calls.len() {
            // Esc between the calls of one batch stops the subagent here, so
            // the rest of the batch does not run after the user asked to stop.
            if st.interrupted() {
                st.emit(DisplayEvent.AgentFinished(id, agent.name, used))
                return "error: interrupted"
            }
            let call = calls[i]
            let result = _sub_one(st, agent, call, allowed)
            st.emit(DisplayEvent.AgentTool(id, agent.name, label(call), _short(result)))
            history.push(Message.tool_result(call.id, call.name, result))
            used = used + 1
            i = i + 1
        }
        round = round + 1
    }
    st.emit(DisplayEvent.AgentFinished(id, agent.name, used))
    return "error: the ${agent.name} agent stopped after ${SUB_ROUNDS} tool rounds"
}

// Run one of the subagent's tool calls: enforce the allowlist, auto-run
// read-only tools, and gate mutating ones through the parent's approval
// prompt (labeled with the agent's name so the user knows who is asking).
fun _sub_one(st: AgentState, agent: Subagent, call: ToolCall, allowed: list[str]) -> str {
    return _sub_one_with_hooks(
        st,
        agent,
        call,
        allowed,
        run_pre_tool_hooks_for_agent,
        _fire_post_tool_hook,
        check_permission,
    )
}

fun _sub_one_with_hooks(
    st: AgentState,
    agent: Subagent,
    call: ToolCall,
    allowed: list[str],
    pre_hook: fun(str, str, str) -> str,
    post_hook: fun(str, str, str) -> Unit,
    permission: fun(ToolCall) -> Verdict,
) -> str {
    if call.name == "dispatch" {
        return "error: subagents cannot dispatch further agents; do the work yourself"
    }
    if call.name == "ask_user" {
        return "error: subagents cannot ask the user; make a reasonable choice or report back"
    }
    let approval_needed = call_needs_approval(call)
    if st.plan() and approval_needed {
        return "error: plan mode is on; you can only read and search, so ${call.name} is unavailable"
    }
    if not _tool_allowed(agent.tools, call.name) {
        return "error: the ${call.name} tool is not available to this agent"
    }
    let vetoed = pre_hook(agent.name, call.name, call.arguments)
    if vetoed != "" {
        return vetoed
    }
    // The user's permission rules bind subagents the same way.
    var denied = ""
    var pre_allowed = false
    match permission(call) {
        case Deny(rule) {
            denied = rule
        }
        case Allow {
            pre_allowed = true
        }
        case Ask {}
    }
    if denied != "" {
        return "This action is blocked by the permission rule '${denied}' in settings. Do not retry it; find another way or report back."
    }
    if not approval_needed {
        return _sub_do(st, agent, call, "", post_hook)
    }
    var preview = call_approval_detail(call)
    if preview == "" {
        preview = change_preview(call)
    }
    if pre_allowed or _contains(allowed, call.name) {
        return _sub_do(st, agent, call, preview, post_hook)
    }
    let decision = st.ask_detail("${agent.name}: ${label(call)}", preview)
    if decision == 2 {
        allowed.push(call.name)
        return _sub_do(st, agent, call, preview, post_hook)
    }
    if decision == 1 {
        return _sub_do(st, agent, call, preview, post_hook)
    }
    return "The user denied this action. Do not retry it; try another way or report back."
}

fun _sub_do(
    st: AgentState,
    agent: Subagent,
    call: ToolCall,
    preview: str,
    post_hook: fun(str, str, str) -> Unit,
) -> str {
    let result = append_preview(dispatch_cancelable(call, st.token()), preview)
    post_hook(agent.name, call.name, call.arguments)
    return result
}

fun _fire_post_tool_hook(agent: str, tool: str, args_json: str) {
    fire_hooks_for_agent(agent, "post-tool", tool, args_json)
    return
}

// The subagent's request: its own prompt and history, the session key and
// endpoint, and only the tools its definition allows.
fun _sub_request(
    model: str,
    prompt: str,
    history: list[Message],
    api_key: str,
    base_url: str,
    allow: list[str],
    plan: bool,
    ts: list[ToolDef],
) -> ChatRequest {
    var req = ChatRequest.new(model).cache(true).system(prompt)
    var i = 0
    while i < history.len() {
        req = req.message(history[i])
        i = i + 1
    }
    if api_key != "" {
        req = req.key(api_key)
    }
    if base_url != "" {
        req = req.base(base_url)
    }
    // A subagent on a slow model (Sakana's two-hour idle allowance) needs the
    // same timeout the main turn applies, or it fails at the 120s default.
    let request_timeout = request_timeout_ms(model, 0)
    if request_timeout > 0 {
        req = req.timeout(request_timeout)
    }
    var t = 0
    while t < ts.len() {
        // Nesting stops at one level, and questions belong to the main
        // agent: a subagent never sees dispatch or ask_user; in plan mode
        // the mutating tools are withheld too.
        var ok = ts[t].name != "dispatch" and ts[t].name != "ask_user" and _tool_allowed(
            allow,
            ts[t].name,
        )
        if plan and needs_approval(ts[t].name) {
            ok = false
        }
        if ok {
            req = req.tool(ts[t])
        }
        t = t + 1
    }
    return req
}

// An empty allowlist means every tool.
fun _tool_allowed(allow: list[str], name: str) -> bool {
    if allow.len() == 0 {
        return true
    }
    return _contains(allow, name)
}

fun _contains(xs: list[str], name: str) -> bool {
    var i = 0
    while i < xs.len() {
        if xs[i] == name {
            return true
        }
        i = i + 1
    }
    return false
}

// A compact one-liner for the tool bullet: the first line, clipped.
fun _short(result: str) -> str {
    var first = result
    let nl = result.index_of("\n")
    if nl >= 0 {
        first = result.substring(0, nl)
    }
    if first.length() > 60 {
        first = "${first.substring(0, 60)}…"
    }
    return first
}

// The stream callback for subagent requests: deltas are not displayed (a
// subagent reports only its final answer), streaming exists so the cancel
// token is checked at every chunk and Esc lands mid-reply.
fun _discard_chunk(d: str) {
    return
}
