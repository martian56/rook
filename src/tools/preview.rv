// The diff a pending write_file or edit_file call would make, computed
// against the file as it is right now: shown in the approval prompt before
// anything runs, and in the transcript after. Other tools have no preview.

import std.string
from std.fs import read, exists
from "github.com/martian56/aviary/message" import ToolCall
from "./args" import arg
from "./git" import git_commit_preview
from "./multiedit" import apply_edits, parse_edits
from "./paths" import resolve_path
from "./web" import web_fetch_approval_detail
from "../ui/diff" import unified

// The unified diff for a mutating file call, or the message for a commit,
// "" for anything else (or when the change is a no-op).
fun change_preview(call: ToolCall) -> str {
    if call.name == "git_commit" {
        return git_commit_preview(arg(call.arguments, "message"))
    }
    if call.name == "write_file" {
        let r = resolve_path(arg(call.arguments, "path"), "")
        if not r.ok {
            return r.error
        }
        let old = _read_opt(r.path)
        return unified(old, arg(call.arguments, "content"))
    }
    if call.name == "edit_file" {
        let r = resolve_path(arg(call.arguments, "path"), "")
        if not r.ok {
            return r.error
        }
        let old = _read_opt(r.path)
        let from = arg(call.arguments, "old_text")
        if old == "" or from == "" {
            return ""
        }
        let at = old.index_of(from)
        if at < 0 {
            return ""
        }
        let before = old.substring(0, at)
        let after = old.substring(at + from.length(), old.length())
        return unified(old, "${before}${arg(call.arguments, "new_text")}${after}")
    }
    if call.name == "multi_edit" {
        let r = resolve_path(arg(call.arguments, "path"), "")
        if not r.ok {
            return r.error
        }
        let old = _read_opt(r.path)
        let outcome = apply_edits(old, parse_edits(call.arguments))
        if not outcome.ok {
            return ""
        }
        return unified(old, outcome.text)
    }
    if call.name == "web_fetch" {
        return web_fetch_approval_detail(arg(call.arguments, "url"))
    }
    return ""
}

// Append a successful mutation preview to the tool result. Errors stay short
// because a failed mutation did not apply the proposed change.
fun append_preview(result: str, preview: str) -> str {
    if preview == "" or result.starts_with("error:") {
        return result
    }
    return "${result}\n${preview}"
}

fun _read_opt(path: str) -> str {
    if path == "" or not exists(path) {
        return ""
    }
    return match read(path) {
        case Ok(s) { s }
        case Err(e) { "" }
    }
}
