import std.string
from std.test import assert_true, assert_eq_str
from std.fs import read, write, exists, remove_file
from "./checkpoints" import (
    begin_checkpoint_batch,
    checkpoint_file,
    rewind_last_batch,
    rewind_summary,
    checkpoint_batches,
    clear_checkpoints,
)

fun test_rewind_restores_edits_and_deletes_created_files() {
    clear_checkpoints()
    write("_rook_ckpt_a.txt", "original")
    begin_checkpoint_batch()
    checkpoint_file("_rook_ckpt_a.txt")
    write("_rook_ckpt_a.txt", "changed")
    // A file the turn created: no pre-image, so rewind deletes it.
    checkpoint_file("_rook_ckpt_b.txt")
    write("_rook_ckpt_b.txt", "new file")
    let summary = rewind_last_batch()
    assert_true(summary.contains("2 file(s)"))
    match read("_rook_ckpt_a.txt") {
        case Ok(t) { assert_eq_str(t, "original") }
        case Err(e) { assert_true(false) }
    }
    assert_true(not exists("_rook_ckpt_b.txt"))
    remove_file("_rook_ckpt_a.txt")
    return
}

fun test_batches_rewind_newest_first() {
    clear_checkpoints()
    write("_rook_ckpt_c.txt", "one")
    begin_checkpoint_batch()
    checkpoint_file("_rook_ckpt_c.txt")
    write("_rook_ckpt_c.txt", "two")
    begin_checkpoint_batch()
    checkpoint_file("_rook_ckpt_c.txt")
    write("_rook_ckpt_c.txt", "three")
    assert_true(checkpoint_batches() == 2)
    let _ = rewind_last_batch()
    match read("_rook_ckpt_c.txt") {
        case Ok(t) { assert_eq_str(t, "two") }
        case Err(e) { assert_true(false) }
    }
    let _ = rewind_last_batch()
    match read("_rook_ckpt_c.txt") {
        case Ok(t) { assert_eq_str(t, "one") }
        case Err(e) { assert_true(false) }
    }
    assert_eq_str(rewind_last_batch(), "")
    remove_file("_rook_ckpt_c.txt")
    return
}

fun test_oversized_file_is_reported_not_silently_skipped() {
    clear_checkpoints()
    write("_rook_ckpt_big.txt", "x" * 600000)
    begin_checkpoint_batch()
    checkpoint_file("_rook_ckpt_big.txt")
    write("_rook_ckpt_big.txt", "changed")
    let summary = rewind_last_batch()
    assert_true(summary.contains("restored 0 file(s)"))
    assert_true(summary.contains("not checkpointed"))
    assert_true(summary.contains("_rook_ckpt_big.txt (over 512 KiB)"))
    remove_file("_rook_ckpt_big.txt")
    return
}

fun test_a_full_store_drops_its_oldest_turn() {
    clear_checkpoints()
    var n = 0
    while n < 250 {
        begin_checkpoint_batch()
        checkpoint_file("_rook_ckpt_many_${n}.txt")
        n += 1
    }
    write("_rook_ckpt_late.txt", "before")
    begin_checkpoint_batch()
    checkpoint_file("_rook_ckpt_late.txt")
    write("_rook_ckpt_late.txt", "after")
    let _ = rewind_last_batch()
    match read("_rook_ckpt_late.txt") {
        case Ok(t) { assert_eq_str(t, "before") }
        case Err(e) { assert_true(false) }
    }
    remove_file("_rook_ckpt_late.txt")
    clear_checkpoints()
    return
}

fun test_summary_lists_failures_separately() {
    let s = rewind_summary(["a.rv"], ["b.rv (denied)"], ["c.bin (over 512 KiB)"])
    assert_eq_str(
        s,
        "restored 1 file(s): a.rv; could not restore 1: b.rv (denied); not checkpointed, so left as changed: c.bin (over 512 KiB)",
    )
    return
}

fun test_the_current_turn_is_never_evicted() {
    clear_checkpoints()
    write("_rook_ckpt_first.txt", "original")
    begin_checkpoint_batch()
    checkpoint_file("_rook_ckpt_first.txt")
    write("_rook_ckpt_first.txt", "edited once")
    var n = 0
    while n < 205 {
        checkpoint_file("_rook_ckpt_many_${n}.txt")
        n += 1
    }
    // A second edit in the same turn keeps the first pre-image.
    checkpoint_file("_rook_ckpt_first.txt")
    write("_rook_ckpt_first.txt", "edited twice")
    let summary = rewind_last_batch()
    match read("_rook_ckpt_first.txt") {
        case Ok(t) { assert_eq_str(t, "original") }
        case Err(e) { assert_true(false) }
    }
    assert_true(summary.contains("checkpoint store full for this turn"))
    remove_file("_rook_ckpt_first.txt")
    clear_checkpoints()
    return
}
