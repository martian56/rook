// File checkpoints: before write_file, edit_file, or multi_edit touches a
// file, its pre-image is recorded here, grouped into batches (one batch per
// turn). /rewind restores the most recent batch, newest first, so a bad
// turn's file changes undo in one step even after the diff was approved.
// In memory only: checkpoints last for the process, capped so a huge
// session cannot balloon.

import std.string
from std.sync import Mutex, mutex
from std.fs import read, write, exists, remove_file

// One file's state before a change. `existed` false means the change
// created it, so restoring deletes it.
class Snapshot {
    batch: int
    path: str
    existed: bool
    content: str
    // Why the file could not be recorded ("" when it was), so /rewind can
    // say which changes it cannot undo instead of skipping them silently.
    skipped: str = ""
}

class CheckpointStore {
    lock: Mutex
    snaps: list[Snapshot]
    batch: int
}

let STORE: CheckpointStore = _new_store()

let MAX_SNAPSHOT_BYTES: int = 524288
let MAX_SNAPSHOTS: int = 200

fun _new_store() -> CheckpointStore {
    let snaps: list[Snapshot] = []
    return CheckpointStore(lock: mutex(), snaps: snaps, batch: 0)
}

// Start a new batch; the turn loop calls this once per turn.
fun begin_checkpoint_batch() {
    STORE.lock.lock()
    STORE.batch = STORE.batch + 1
    STORE.lock.unlock()
    return
}

// Record `path`'s current state, once per batch per path (the first
// pre-image in a turn is the one worth restoring). Oversized files are
// skipped rather than half-recorded.
fun checkpoint_file(path: str) {
    STORE.lock.lock()
    let batch = STORE.batch
    var already = false
    var i = 0
    while i < STORE.snaps.len() {
        if STORE.snaps[i].batch == batch and STORE.snaps[i].path == path {
            already = true
        }
        i = i + 1
    }
    STORE.lock.unlock()
    if already {
        return
    }
    let existed = exists(path)
    var content = ""
    var skipped = ""
    if existed {
        match read(path) {
            case Ok(t) {
                content = t
            }
            case Err(e) {
                skipped = "unreadable: ${e.message()}"
            }
        }
        if content.length() > MAX_SNAPSHOT_BYTES {
            content = ""
            skipped = "over ${MAX_SNAPSHOT_BYTES / 1024} KiB"
        }
    }
    STORE.lock.lock()
    // A full store drops its oldest finished turn, so recent turns stay
    // undoable. The current turn is never evicted: its first pre-images are
    // what /rewind must restore. When the current turn alone fills the store,
    // later files are recorded as unprotected rather than dropped silently.
    while STORE.snaps.len() >= MAX_SNAPSHOTS and STORE.snaps[0].batch != STORE.batch {
        let oldest = STORE.snaps[0].batch
        let kept: list[Snapshot] = []
        for s in STORE.snaps {
            if s.batch != oldest {
                kept.push(s)
            }
        }
        STORE.snaps = kept
    }
    if STORE.snaps.len() >= MAX_SNAPSHOTS and skipped == "" {
        content = ""
        skipped = "checkpoint store full for this turn"
    }
    STORE.snaps.push(
        Snapshot(
            batch: STORE.batch,
            path: path,
            existed: existed,
            content: content,
            skipped: skipped,
        ),
    )
    STORE.lock.unlock()
    return
}

// Undo the most recent batch that has snapshots: every recorded file goes
// back to its pre-image (created files are deleted). Returns a summary
// line, or "" when there is nothing to rewind.
fun rewind_last_batch() -> str {
    STORE.lock.lock()
    var last = 0
    var i = 0
    while i < STORE.snaps.len() {
        if STORE.snaps[i].batch > last {
            last = STORE.snaps[i].batch
        }
        i = i + 1
    }
    if last == 0 {
        STORE.lock.unlock()
        return ""
    }
    let todo: list[Snapshot] = []
    let keep: list[Snapshot] = []
    i = 0
    while i < STORE.snaps.len() {
        if STORE.snaps[i].batch == last {
            todo.push(STORE.snaps[i])
        } else {
            keep.push(STORE.snaps[i])
        }
        i = i + 1
    }
    STORE.snaps = keep
    STORE.lock.unlock()
    let restored: list[str] = []
    let failed: list[str] = []
    let unprotected: list[str] = []
    for s in todo {
        if s.skipped != "" {
            unprotected.push("${s.path} (${s.skipped})")
            continue
        }
        var error = ""
        if s.existed {
            match write(s.path, s.content) {
                case Ok(ok) {}
                case Err(e) {
                    error = e.message()
                }
            }
        } else if exists(s.path) {
            match remove_file(s.path) {
                case Ok(ok) {}
                case Err(e) {
                    error = e.message()
                }
            }
        }
        restored.push(s.path) if error == "" else failed.push("${s.path} (${error})")
    }
    return rewind_summary(restored, failed, unprotected)
}

// The /rewind report: what was restored, what failed, and what was never
// recorded, so a partial undo never reads as a complete one.
fun rewind_summary(restored: list[str], failed: list[str], unprotected: list[str]) -> str {
    var out = "restored ${restored.len()} file(s)"
    if restored.len() > 0 {
        out += ": ${", ".join(restored)}"
    }
    if failed.len() > 0 {
        out += "; could not restore ${failed.len()}: ${", ".join(failed)}"
    }
    if unprotected.len() > 0 {
        out += "; not checkpointed, so left as changed: ${", ".join(unprotected)}"
    }
    return out
}

// How many batches still have snapshots, for the /rewind notice.
fun checkpoint_batches() -> int {
    STORE.lock.lock()
    let seen: list[int] = []
    var i = 0
    while i < STORE.snaps.len() {
        let b = STORE.snaps[i].batch
        var have = false
        var j = 0
        while j < seen.len() {
            if seen[j] == b {
                have = true
            }
            j = j + 1
        }
        if not have {
            seen.push(b)
        }
        i = i + 1
    }
    let n = seen.len()
    STORE.lock.unlock()
    return n
}

// For tests: drop everything.
fun clear_checkpoints() {
    STORE.lock.lock()
    let none: list[Snapshot] = []
    STORE.snaps = none
    STORE.batch = 0
    STORE.lock.unlock()
    return
}
