// The file_tree tool: one indented view of the project structure, so the
// model orients in an unfamiliar repo without a chain of list_dir calls.
// Depth-limited, noise directories skipped, entry count capped.

import std.string
from std.fs import list_dir, is_dir, is_symlink
from "./paths" import resolve_path

// Directories that are dependency or build noise, never part of the shape
// a reader needs.
fun _ignored(name: str) -> bool {
    if name == "node_modules" or name == "target" or name == "dist" or name == "__pycache__" {
        return true
    }
    // Hidden entries stay hidden, except the two that describe the project.
    if name.starts_with(".") {
        return name != ".agents" and name != ".github"
    }
    return false
}

let MAX_ENTRIES: int = 200
let DEFAULT_DEPTH: int = 3

// Render the tree under `path` (default "."), `depth_text` levels deep
// (default 3). Directories end with "/".
fun file_tree(path: str, depth_text: str) -> str {
    let resolved = resolve_path(path, ".")
    if not resolved.ok {
        return resolved.error
    }
    let root = resolved.path
    var depth = DEFAULT_DEPTH
    match depth_text.trim().parse_int() {
        case Some(n) {
            if n > 0 {
                depth = n
            }
        }
        case None {}
    }
    if not is_dir(root) or is_symlink(root) {
        return "error: ${root} is not a directory"
    }
    let out: list[str] = []
    _walk(root, "", depth, out)
    if out.len() == 0 {
        return "(empty)"
    }
    var text = ""
    var i = 0
    while i < out.len() {
        if i > 0 {
            text = text.concat("\n")
        }
        text = text.concat(out[i])
        i = i + 1
    }
    if out.len() >= MAX_ENTRIES {
        text = "${text}\n… truncated at ${MAX_ENTRIES} entries; ask for a subdirectory"
    }
    return text
}

fun _walk(dir: str, indent: str, depth: int, out: list[str]) {
    if depth <= 0 or out.len() >= MAX_ENTRIES {
        return
    }
    var names: list[str] = []
    match list_dir(dir) {
        case Ok(ns) {
            names = ns
        }
        case Err(e) {
            return
        }
    }
    var i = 0
    while i < names.len() and out.len() < MAX_ENTRIES {
        let name = names[i]
        if not _ignored(name) {
            let full = "${dir}/${name}"
            if not is_symlink(full) {
                if is_dir(full) {
                    out.push("${indent}${name}/")
                    _walk(full, "${indent}  ", depth - 1, out)
                } else {
                    out.push("${indent}${name}")
                }
            }
        }
        i = i + 1
    }
    return
}
