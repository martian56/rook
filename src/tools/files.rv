// File tools. Each returns a plain result string that is both shown in the
// transcript and fed back to the model, so an error is just a string that
// starts with "error:".

import std.string
from std.fs import read, write, exists, list_dir as fs_list
from "./paths" import resolve_path
from "./checkpoints" import checkpoint_file

// The most read_file returns, so one large file cannot fill the model's
// context window. The cut lands on a line boundary.
let MAX_READ: int = 200000

fun read_file(path: str) -> str {
    let r = resolve_path(path, "")
    if not r.ok {
        return r.error
    }
    return match read(r.path) {
        case Ok(s) { cap_read(s) }
        case Err(e) { "error: ${e.message}" }
    }
}

fun cap_read(s: str) -> str {
    if s.length() <= MAX_READ {
        return s
    }
    var cut = s.substring(0, MAX_READ).last_index_of("\n")
    if cut <= 0 {
        // No newline to cut at: back off to a UTF-8 character boundary.
        cut = MAX_READ
        while cut > 0 and s.byte_at(cut) >= 128 and s.byte_at(cut) < 192 {
            cut -= 1
        }
    }
    let shown_lines = s.substring(0, cut).split("\n").len()
    return "${s.substring(0, cut)}\n... (truncated: first ${shown_lines} lines, ${cut} of ${s.length()} bytes; use grep or run_command with sed to read further)"
}

fun list_dir(path: str) -> str {
    let r = resolve_path(path, ".")
    if not r.ok {
        return r.error
    }
    return match fs_list(r.path) {
        case Ok(names) { _join_lines(names) }
        case Err(e) { "error: ${e.message}" }
    }
}

fun write_file(path: str, content: str) -> str {
    let r = resolve_path(path, "")
    if not r.ok {
        return r.error
    }
    checkpoint_file(r.path)
    return _write_result(r.path, content, "wrote ${content.length()} bytes to ${r.path}")
}

// How many non-overlapping times `needle` occurs in `haystack`. An empty
// needle counts as zero. Used to refuse an ambiguous edit.
fun count_occurrences(haystack: str, needle: str) -> int {
    if needle == "" {
        return 0
    }
    var count = 0
    var rest = haystack
    var at = rest.index_of(needle)
    while at >= 0 {
        count = count + 1
        rest = rest.substring(at + needle.length(), rest.length())
        at = rest.index_of(needle)
    }
    return count
}

fun edit_file(path: str, old_text: str, new_text: str) -> str {
    let r = resolve_path(path, "")
    if not r.ok {
        return r.error
    }
    checkpoint_file(r.path)
    if old_text == "" {
        return "error: old_text is empty"
    }
    if not exists(r.path) {
        return "error: no such file: ${r.path}"
    }
    var ok = true
    var content = ""
    match read(r.path) {
        case Ok(s) {
            content = s
        }
        case Err(e) {
            ok = false
            content = e.message
        }
    }
    if not ok {
        return "error: ${content}"
    }
    let idx = content.index_of(old_text)
    if idx < 0 {
        return "error: old_text not found in ${r.path}"
    }
    if count_occurrences(content, old_text) > 1 {
        return "error: old_text appears more than once in ${r.path}; include more surrounding context so it matches exactly one place"
    }
    let before = content.substring(0, idx)
    let after = content.substring(idx + old_text.length(), content.length())
    let updated = "${before}${new_text}${after}"
    return _write_result(r.path, updated, "edited ${r.path}")
}

fun _write_result(path: str, content: str, ok_msg: str) -> str {
    return match write(path, content) {
        case Ok(b) { ok_msg }
        case Err(e) { "error: ${e.message}" }
    }
}

fun _join_lines(xs: list[str]) -> str {
    var out = ""
    var i = 0
    while i < xs.len() {
        if i > 0 {
            out = out.concat("\n")
        }
        out = out.concat(xs[i])
        i = i + 1
    }
    return out
}
