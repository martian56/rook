// @-file mentions: type @ in the input to pick a project file by fuzzy path
// match; the reference stays in the message, and on send the referenced
// files are attached so the model has them without a separate read.
//
// current_mention and fuzzy_match are pure (the UI drives them per key);
// list_files and expand_mentions touch the filesystem (the walk that feeds
// the picker, and the attachment on send).

import std.string
from std.sync import Mutex, mutex
from std.fs import read, exists, is_file, is_dir, is_symlink, list_dir
from "./paths" import resolve_path

// The @token being typed at the end of the input, if any. `at` is the index
// of the @, for completing the reference in place.
class Mention {
    active: bool
    at: int
    query: str
}

// The live mention in `input`: the last @token, when it starts a word and
// its tail has no whitespace yet. Anchored at the end, which is where typing
// happens.
fun current_mention(input: str) -> Mention {
    let at = input.last_index_of("@")
    if at < 0 {
        return Mention(active: false, at: 0, query: "")
    }
    // Must begin a word: at the start, or after whitespace.
    if at > 0 {
        let b = input.byte_at(at - 1)
        if b != 32 and b != 9 and b != 10 {
            return Mention(active: false, at: 0, query: "")
        }
    }
    let query = input.substring(at + 1, input.length())
    if query.contains(" ") or query.contains("\t") {
        return Mention(active: false, at: 0, query: "")
    }
    return Mention(active: true, at: at, query: query)
}

// The project's files as relative paths, for the picker. Depth-first,
// build and dependency noise skipped, capped so a huge tree cannot stall.
let MAX_FILES: int = 4000

fun list_files() -> list[str] {
    let out: list[str] = []
    _walk_files(".", out)
    return out
}

// The walk is expensive, and the @-picker filters the same list on every
// keystroke while the tree does not change mid-token, so cache it. The cache
// is invalidated on submit (files created during the turn show up next
// prompt) and rebuilt off the UI thread by warm_files, so typing @ filters a
// ready list instead of stalling on a project walk. Locked because the warm
// goroutine fills it while the UI reads it.
class FileCache {
    lock: Mutex
    ready: bool
    files: list[str]
}

let FILE_CACHE: FileCache = _new_file_cache()

fun _new_file_cache() -> FileCache {
    let files: list[str] = []
    return FileCache(lock: mutex(), ready: false, files: files)
}

// The project files. Normally the warm goroutine has already filled the
// cache; the inline walk is the fallback when the picker is used before a
// warm finished (it may briefly duplicate a running warm's work, which is
// harmless: both store the same fresh list).
fun cached_files() -> list[str] {
    FILE_CACHE.lock.lock()
    let ready = FILE_CACHE.ready
    let files = FILE_CACHE.files
    FILE_CACHE.lock.unlock()
    if ready {
        return files
    }
    let fresh = list_files()
    FILE_CACHE.lock.lock()
    FILE_CACHE.files = fresh
    FILE_CACHE.ready = true
    FILE_CACHE.lock.unlock()
    return fresh
}

// Drop the cache so the next rebuild walks fresh.
fun invalidate_files() {
    FILE_CACHE.lock.lock()
    FILE_CACHE.ready = false
    FILE_CACHE.lock.unlock()
    return
}

// Rebuild the cache on a goroutine if it is cold, so the walk happens before
// the user next types @ instead of on that keystroke. Called at startup and
// after each submit's invalidation.
fun warm_files() {
    FILE_CACHE.lock.lock()
    let ready = FILE_CACHE.ready
    FILE_CACHE.lock.unlock()
    if ready {
        return
    }
    spawn {
        let fresh = list_files()
        FILE_CACHE.lock.lock()
        if not FILE_CACHE.ready {
            FILE_CACHE.files = fresh
            FILE_CACHE.ready = true
        }
        FILE_CACHE.lock.unlock()
        return
    }
    return
}

fun _walk_files(dir: str, out: list[str]) {
    if out.len() >= MAX_FILES {
        return
    }
    var names: list[str] = []
    match list_dir(dir) {
        case Ok(ns) {
            names = ns
        }
        case Err(e) {
            return
        }
    }
    var i = 0
    while i < names.len() and out.len() < MAX_FILES {
        let name = names[i]
        if not _ignored(name) {
            let full = "${dir}/${name}"
            var rel = full
            if rel.starts_with("./") {
                rel = rel.substring(2, rel.length())
            }
            if not is_symlink(full) {
                _walk_files(full, out) if is_dir(full) else out.push(rel)
            }
        }
        i = i + 1
    }
    return
}

fun _ignored(name: str) -> bool {
    if name == "node_modules" or name == "target" or name == "dist" or name == "__pycache__" {
        return true
    }
    if name.starts_with(".") {
        return name != ".agents" and name != ".github"
    }
    return false
}

// The best matches for `query` among `paths`, highest first, capped. An
// empty query returns the head of the list.
let MAX_MATCHES: int = 8

fun fuzzy_match(query: str, paths: list[str]) -> list[str] {
    if query.trim() == "" {
        return _head(paths, MAX_MATCHES)
    }
    let q = query.to_lower()
    // Bucket by score so the ordering is stable and cheap: 0 basename
    // substring, 1 path substring, 2 subsequence.
    let b0: list[str] = []
    let b1: list[str] = []
    let b2: list[str] = []
    var i = 0
    while i < paths.len() {
        let p = paths[i]
        let lp = p.to_lower()
        if _basename(lp).contains(q) {
            b0.push(p)
        } else {
            b1.push(p) if lp.contains(q) else if _subsequence(q, lp) {
                b2.push(p)
            }
        }
        i = i + 1
    }
    let out: list[str] = []
    _take_into(b0, out, MAX_MATCHES)
    _take_into(b1, out, MAX_MATCHES)
    _take_into(b2, out, MAX_MATCHES)
    return out
}

// Attach real files referenced by @tokens in `text`, capped as a whole so a
// prompt cannot balloon from many mentions. Returns `text` unchanged when
// nothing valid is referenced.
let MAX_ATTACH: int = 20000
let MAX_ATTACH_TOTAL: int = 60000
let MAX_ATTACH_FILES: int = 10

class Attachment {
    body: str
    used: int
}

fun expand_mentions(text: str) -> str {
    let paths = mentioned_paths(text)
    if paths.len() == 0 {
        return text
    }
    var out = text
    let omitted: list[str] = []
    var used = 0
    var attached = 0
    var i = 0
    while i < paths.len() {
        if attached >= MAX_ATTACH_FILES or used >= MAX_ATTACH_TOTAL {
            omitted.push(paths[i])
        } else {
            let body = _read_budgeted(paths[i], MAX_ATTACH_TOTAL - used)
            out = "${out}\n\n--- ${paths[i]} ---\n${body.body}"
            used = used + body.used
            attached = attached + 1
        }
        i = i + 1
    }
    if omitted.len() > 0 {
        out = out.concat(_omitted_note(omitted))
    }
    return out
}

// The real files an @token in `text` points at, in order, deduped.
fun mentioned_paths(text: str) -> list[str] {
    let out: list[str] = []
    let tokens = text.split_whitespace()
    var i = 0
    while i < tokens.len() {
        let t = tokens[i]
        if t.starts_with("@") and t.length() > 1 {
            let r = resolve_path(t.substring(1, t.length()), "")
            if r.ok and exists(r.path) and is_file(r.path) and not _contains(out, r.path) {
                out.push(r.path)
            }
        }
        i = i + 1
    }
    return out
}

fun _read_budgeted(path: str, remaining: int) -> Attachment {
    let body = match read(path) {
        case Ok(s) { s }
        case Err(e) { "(could not read ${path})" }
    }
    var cap = MAX_ATTACH
    if remaining < cap {
        cap = remaining
    }
    if body.length() > cap {
        return Attachment(body: "${body.substring(0, cap)}\n... (truncated)", used: cap)
    }
    return Attachment(body: body, used: body.length())
}

fun _omitted_note(paths: list[str]) -> str {
    var out = "\n\n--- mention attachments omitted ---\n"
    out = out.concat(
        "Omitted ${paths.len()} file(s) after the mention attachment budget. Use read_file for any omitted file you need.\n",
    )
    var i = 0
    while i < paths.len() {
        out = out.concat("- ${paths[i]}\n")
        i = i + 1
    }
    return out
}

fun _read_capped(path: str) -> str {
    let body = match read(path) {
        case Ok(s) { s }
        case Err(e) { "(could not read ${path})" }
    }
    if body.length() > MAX_ATTACH {
        return "${body.substring(0, MAX_ATTACH)}\n… (truncated)"
    }
    return body
}

// Whether `q` occurs as a subsequence of `s` (both already lowercased).
fun _subsequence(q: str, s: str) -> bool {
    var qi = 0
    var si = 0
    while qi < q.length() and si < s.length() {
        if q.byte_at(qi) == s.byte_at(si) {
            qi = qi + 1
        }
        si = si + 1
    }
    return qi >= q.length()
}

fun _basename(path: str) -> str {
    let slash = path.last_index_of("/")
    if slash < 0 {
        return path
    }
    return path.substring(slash + 1, path.length())
}

fun _head(xs: list[str], n: int) -> list[str] {
    let out: list[str] = []
    var i = 0
    while i < xs.len() and i < n {
        out.push(xs[i])
        i = i + 1
    }
    return out
}

fun _take_into(src: list[str], dst: list[str], cap: int) {
    var i = 0
    while i < src.len() and dst.len() < cap {
        dst.push(src[i])
        i = i + 1
    }
    return
}

fun _contains(xs: list[str], x: str) -> bool {
    var i = 0
    while i < xs.len() {
        if xs[i] == x {
            return true
        }
        i = i + 1
    }
    return false
}
