// User-facing permission grants for the /permissions menu. The menu writes
// allow rules only to global user settings, preserving deny rules and the
// rest of ~/.agents/settings.json.

import std.string
from std.env import get_env, has_env
from std.fs import read, write, exists, create_dir_all
from std.json import JsonValue, parse, stringify
from "github.com/martian56/aviary/jsonutil" import Obj, field, as_str, as_list

class PermissionGrant {
    name: str
    desc: str
    rules: list[str]
}

class PermissionGrantState {
    name: str
    desc: str
    rules: list[str]
    enabled: bool
}

class SettingsText {
    text: str
    error: str
}

fun permission_grants() -> list[PermissionGrant] {
    return [
        PermissionGrant(
            name: "File edits",
            desc: "write_file, edit_file, and multi_edit",
            rules: ["write_file", "edit_file", "multi_edit"],
        ),
        PermissionGrant(
            name: "Shell commands",
            desc: "foreground run_command calls",
            rules: ["run_command"],
        ),
        PermissionGrant(
            name: "Background shells",
            desc: "start and stop long-running commands",
            rules: ["run_background", "kill_shell"],
        ),
        PermissionGrant(
            name: "Git commits",
            desc: "commit already staged changes",
            rules: ["git_commit"],
        ),
        PermissionGrant(
            name: "MCP tools",
            desc: "all connected MCP server tools",
            rules: ["mcp__*"],
        ),
    ]
}

fun permission_grant_states() -> list[PermissionGrantState] {
    return permission_states_from_allow(read_user_allow_rules())
}

fun permission_states_from_allow(allow: list[str]) -> list[PermissionGrantState] {
    let out: list[PermissionGrantState] = []
    let grants = permission_grants()
    var i = 0
    while i < grants.len() {
        out.push(
            PermissionGrantState(
                name: grants[i].name,
                desc: grants[i].desc,
                rules: grants[i].rules,
                enabled: grant_enabled(allow, grants[i]),
            ),
        )
        i = i + 1
    }
    return out
}

fun toggle_permission_grant(index: int) -> str {
    let grants = permission_grants()
    if index < 0 or index >= grants.len() {
        return "no permission grant selected"
    }
    let loaded = read_user_settings()
    if loaded.error != "" {
        return loaded.error
    }
    let existing = loaded.text
    if existing.trim() != "" {
        match parse(existing) {
            case Ok(j) {}
            case Err(e) {
                return "error: ~/.agents/settings.json is not valid JSON"
            }
        }
    }
    let allow = allow_rules_from_settings(existing)
    let next_rules = toggle_grant_rules(allow, grants[index])
    let err = write_user_allow_rules(existing, next_rules)
    if err != "" {
        return err
    }
    if grant_enabled(next_rules, grants[index]) {
        return "granted ${grants[index].name}"
    }
    return "revoked ${grants[index].name}"
}

fun read_user_allow_rules() -> list[str] {
    let loaded = read_user_settings()
    if loaded.error != "" {
        let out: list[str] = []
        return out
    }
    return allow_rules_from_settings(loaded.text)
}

fun allow_rules_from_settings(text: str) -> list[str] {
    let out: list[str] = []
    if text.trim() == "" {
        return out
    }
    match parse(text) {
        case Ok(j) {
            return _strings(field(field(j, "permissions"), "allow"))
        }
        case Err(e) {}
    }
    return out
}

fun toggle_grant_rules(allow: list[str], grant: PermissionGrant) -> list[str] {
    if grant_enabled(allow, grant) {
        return _without(allow, grant.rules)
    }
    return _with_missing(allow, grant.rules)
}

fun grant_enabled(allow: list[str], grant: PermissionGrant) -> bool {
    var i = 0
    while i < grant.rules.len() {
        if not _contains(allow, grant.rules[i]) {
            return false
        }
        i = i + 1
    }
    return true
}

fun write_user_allow_rules(existing: str, allow: list[str]) -> str {
    let root = user_agents_root()
    if root == "" {
        return "error: no home directory for ~/.agents/settings.json"
    }
    match create_dir_all(root) {
        case Ok(ok) {}
        case Err(e) {
            return "error: could not create ~/.agents: ${e.message}"
        }
    }
    match write("${root}/settings.json", settings_with_allow(existing, allow)) {
        case Ok(ok) {}
        case Err(e) {
            return "error: could not write ~/.agents/settings.json: ${e.message}"
        }
    }
    return ""
}

fun read_user_settings() -> SettingsText {
    let path = user_settings_path()
    if path == "" {
        return SettingsText(text: "", error: "")
    }
    if not exists(path) {
        return SettingsText(text: "", error: "")
    }
    return match read(path) {
        case Ok(s) { SettingsText(text: s, error: "") }
        case Err(e) {
            SettingsText(text: "", error: "error: could not read ~/.agents/settings.json: ${e.message}")
        }
    }
}

fun settings_with_allow(existing: str, allow: list[str]) -> str {
    var doc = Obj.new()
    var perms = Obj.new()
    if existing.trim() != "" {
        match parse(existing) {
            case Ok(j) {
                let ks = j.keys()
                var i = 0
                while i < ks.len() {
                    if ks[i] == "permissions" {
                        match j.get("permissions") {
                            case Some(p) {
                                let pks = p.keys()
                                var k = 0
                                while k < pks.len() {
                                    if pks[k] != "allow" {
                                        match p.get(pks[k]) {
                                            case Some(v) {
                                                perms = perms.set(pks[k], v)
                                            }
                                            case None {}
                                        }
                                    }
                                    k = k + 1
                                }
                            }
                            case None {}
                        }
                    } else {
                        match j.get(ks[i]) {
                            case Some(v) {
                                doc = doc.set(ks[i], v)
                            }
                            case None {}
                        }
                    }
                    i = i + 1
                }
            }
            case Err(e) {}
        }
    }
    let arr: list[JsonValue] = []
    var a = 0
    while a < allow.len() {
        arr.push(JsonValue.Str(allow[a]))
        a = a + 1
    }
    perms = perms.set("allow", JsonValue.Array(arr))
    doc = doc.set("permissions", perms.build())
    return stringify(doc.build())
}

fun user_agents_root() -> str {
    let h = _home()
    if h == "" {
        return ""
    }
    return "${h}/.agents"
}

fun user_settings_path() -> str {
    let root = user_agents_root()
    if root == "" {
        return ""
    }
    return "${root}/settings.json"
}

fun _read_opt(path: str) -> str {
    if path == "" {
        return ""
    }
    if not exists(path) {
        return ""
    }
    return match read(path) {
        case Ok(s) { s }
        case Err(e) { "" }
    }
}

fun _strings(j: JsonValue) -> list[str] {
    let out: list[str] = []
    let arr = as_list(j)
    var i = 0
    while i < arr.len() {
        let s = as_str(arr[i])
        if s != "" {
            out.push(s)
        }
        i = i + 1
    }
    return out
}

fun _with_missing(allow: list[str], rules: list[str]) -> list[str] {
    let out: list[str] = []
    var i = 0
    while i < allow.len() {
        if not _contains(out, allow[i]) {
            out.push(allow[i])
        }
        i = i + 1
    }
    var r = 0
    while r < rules.len() {
        if not _contains(out, rules[r]) {
            out.push(rules[r])
        }
        r = r + 1
    }
    return out
}

fun _without(allow: list[str], rules: list[str]) -> list[str] {
    let out: list[str] = []
    var i = 0
    while i < allow.len() {
        if not _contains(rules, allow[i]) and not _contains(out, allow[i]) {
            out.push(allow[i])
        }
        i = i + 1
    }
    return out
}

fun _contains(xs: list[str], x: str) -> bool {
    var i = 0
    while i < xs.len() {
        if xs[i] == x {
            return true
        }
        i = i + 1
    }
    return false
}

fun _home() -> str {
    if has_env("HOME") {
        let h = get_env("HOME")
        if h != "" {
            return h
        }
    }
    if has_env("USERPROFILE") {
        return get_env("USERPROFILE")
    }
    return ""
}
