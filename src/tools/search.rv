// A regex grep over a directory tree (RE2 syntax via std/regex: no
// backreferences or lookaround), capped at a sane number of hits so a huge
// tree cannot flood the model's context. Case-insensitive matching is the
// engine's own `(?i)` inline flag, and an optional glob narrows which files
// are searched by name.

import std.string
from std.regex import compile, Regex
from std.fs import list_dir, read, is_file, is_dir, is_symlink, basename
from "./paths" import resolve_path

let MAX_MATCHES: int = 50

fun grep(pattern: str, path: str, glob: str) -> str {
    if pattern == "" {
        return "error: no pattern given"
    }
    var root = path
    if root == "" {
        root = "."
    }
    let resolved = resolve_path(root, ".")
    if not resolved.ok {
        return resolved.error
    }
    return match compile(pattern) {
        case Ok(re) { _grep_with_pattern(re, resolved.path, pattern, glob) }
        case Err(e) { "error: invalid pattern: ${e.message}" }
    }
}

fun _grep_with_pattern(re: Regex, root: str, pattern: str, glob: str) -> str {
    let has_glob = glob != ""
    let result = match compile(_glob_to_regex(glob)) {
        case Ok(name_re) { _grep_with_regexes(re, name_re, root, pattern, has_glob) }
        case Err(e) { "error: invalid glob: ${e.message}" }
    }
    re.free()
    return result
}

fun _grep_with_regexes(re: Regex, name_re: Regex, root: str, pattern: str, has_glob: bool) -> str {
    let files: list[str] = []
    _collect_files(root, files, _has_ignored_segment(root))

    var out = ""
    var count = 0
    var i = 0
    while i < files.len() and count < MAX_MATCHES {
        let f = files[i]
        if not has_glob or name_re.is_match(basename(f)) {
            var content = ""
            var rok = true
            match read(f) {
                case Ok(s) {
                    content = s
                }
                case Err(e) {
                    rok = false
                }
            }
            if rok {
                let lines = content.lines()
                var ln = 0
                while ln < lines.len() and count < MAX_MATCHES {
                    if re.is_match(lines[ln]) {
                        out = out.concat("${f}:${ln + 1}: ${lines[ln]}\n")
                        count = count + 1
                    }
                    ln = ln + 1
                }
            }
        }
        i = i + 1
    }
    if count == 0 {
        out = "no matches for '${pattern}' under ${root}"
    }
    name_re.free()
    return out
}

fun _collect_files(path: str, out: list[str], include_ignored: bool) {
    if is_symlink(path) {
        return
    }
    if is_file(path) {
        out.push(path)
        return
    }
    if not is_dir(path) {
        return
    }
    var names: list[str] = []
    match list_dir(path) {
        case Ok(ns) {
            names = ns
        }
        case Err(e) {
            return
        }
    }
    var i = 0
    while i < names.len() {
        let name = names[i]
        let full = "${path}/${name}"
        if not is_symlink(full) {
            if is_dir(full) {
                if include_ignored or not _ignored(name) {
                    _collect_files(full, out, include_ignored)
                }
            } else if is_file(full) {
                out.push(full)
            }
        }
        i = i + 1
    }
    return
}

fun _has_ignored_segment(path: str) -> bool {
    let parts = path.split("/")
    var i = 0
    while i < parts.len() {
        if _ignored(parts[i]) {
            return true
        }
        i = i + 1
    }
    return false
}

fun _ignored(name: str) -> bool {
    if name == "node_modules" or name == "target" or name == "dist" or name == "build" or name == "out" or name == "vendor" or name == "__pycache__" {
        return true
    }
    if name.starts_with(".") {
        return name != ".agents" and name != ".github"
    }
    return false
}

// Translates a shell-style glob (`*` any run, `?` one char, everything else
// literal) into an anchored regex. An empty glob (no filter requested)
// becomes `.*` so it matches any name without ever being consulted.
fun _glob_to_regex(glob: str) -> str {
    if glob == "" {
        return ".*"
    }
    var out = ""
    var i = 0
    while i < glob.length() {
        let c = glob.char_at(i)
        if c == "*" {
            out = out.concat(".*")
        } else if c == "?" {
            out = out.concat(".")
        } else if _is_regex_meta(c) {
            out = out.concat("\\").concat(c)
        } else {
            out = out.concat(c)
        }
        i = i + 1
    }
    return "^${out}$"
}

fun _is_regex_meta(c: str) -> bool {
    return c == "." or c == "^" or c == "$" or c == "+" or c == "(" or c == ")" or c == "[" or c == "]" or c == "{" or c == "}" or c == "|" or c == "\\"
}
