// Run a shell command in the working directory. The command string is
// handed to the platform shell (sh -c / cmd /c), and stdout, stderr, and the
// exit code come back as one result, truncated so a noisy command cannot
// bury the answer. Foreground commands are polled so a bad command can be
// killed on timeout or turn interruption.

import std.string
from std.env import os_name
from std.sync import sleep_millis
from std.json import JsonValue
from std.process import Child, start, Output
from "github.com/martian56/aviary/request" import CancelToken
from "../agents/dir" import roots
from "../agents/settings" import setting_section

let MAX_OUTPUT: int = 4000
let DEFAULT_TIMEOUT_MS: int = 120000
let POLL_MS: int = 25

fun run_command(command: str) -> str {
    return run_command_cancelable(command, CancelToken.new())
}

fun run_command_cancelable(command: str, token: CancelToken) -> str {
    return run_command_with_timeout_cancelable(command, command_timeout_ms(), token)
}

fun run_command_with_timeout(command: str, timeout_ms: int) -> str {
    return run_command_with_timeout_cancelable(command, timeout_ms, CancelToken.new())
}

fun run_command_with_timeout_cancelable(command: str, timeout_ms: int, token: CancelToken) -> str {
    if command == "" {
        return "error: no command given"
    }
    var shell = "sh"
    var flag = "-c"
    if os_name() == "windows" {
        shell = "cmd"
        flag = "/c"
    }
    return match start(shell, [flag, command]) {
        case Ok(child) { _run_child(child, timeout_ms, token) }
        case Err(e) { "error: ${e.message}" }
    }
}

fun command_timeout_ms() -> int {
    let rs = roots()
    var i = 0
    while i < rs.len() {
        match setting_section(rs[i], "tools") {
            case Some(section) {
                let n = parse_run_command_timeout_ms(section)
                if n > 0 {
                    return n
                }
            }
            case None {}
        }
        i = i + 1
    }
    return DEFAULT_TIMEOUT_MS
}

fun parse_run_command_timeout_ms(section: JsonValue) -> int {
    match section.get("run_command") {
        case Some(tool) {
            let n = _json_int_field(tool, "timeout_ms")
            if n > 0 {
                return n
            }
        }
        case None {}
    }
    return _json_int_field(section, "run_command_timeout_ms")
}

fun _run_child(child: Child, timeout_ms: int, token: CancelToken) -> str {
    child.close_stdin()
    var stdout = ""
    var stderr = ""
    var waited = 0
    var limit = timeout_ms
    if limit <= 0 {
        limit = DEFAULT_TIMEOUT_MS
    }
    while true {
        stdout = stdout.concat(child.read_stdout())
        stderr = stderr.concat(child.read_stderr())
        if token.canceled() {
            return _stop_child(child, "interrupted", stdout, stderr)
        }
        match child.poll() {
            case Some(code) {
                stdout = stdout.concat(child.read_stdout())
                stderr = stderr.concat(child.read_stderr())
                child.free()
                return _format(Output(code: code, stdout: stdout, stderr: stderr))
            }
            case None {}
        }
        if waited >= limit {
            return _stop_child(child, "timed out after ${limit}ms", stdout, stderr)
        }
        sleep_millis(POLL_MS)
        waited = waited + POLL_MS
    }
    return "error: unreachable"
}

fun _stop_child(child: Child, reason: str, stdout: str, stderr: str) -> str {
    let ignored = child.kill()
    let code = child.wait()
    let out = stdout.concat(child.read_stdout())
    let err = stderr.concat(child.read_stderr())
    child.free()
    return _format_stopped(reason, code, out, err)
}

fun _format(out: Output) -> str {
    let body = _body(out.stdout, out.stderr)
    let head = "exit ${out.code}"
    if body == "" {
        return head
    }
    return "${head}\n${body}"
}

fun _format_stopped(reason: str, code: int, stdout: str, stderr: str) -> str {
    let body = _body(stdout, stderr)
    let head = "${reason} (killed, exit ${code})"
    if body == "" {
        return head
    }
    return "${head}\n${body}"
}

fun _body(stdout: str, stderr: str) -> str {
    var body = stdout
    if stderr != "" {
        if body != "" {
            body = "${body}\n"
        }
        body = "${body}${stderr}"
    }
    if body.length() > MAX_OUTPUT {
        body = "${body.substring(0, MAX_OUTPUT)}\n... (truncated)"
    }
    return body
}

fun _json_int_field(j: JsonValue, key: str) -> int {
    return match j.get(key) {
        case Some(v) { _json_int(v) }
        case None { 0 }
    }
}

fun _json_int(v: JsonValue) -> int {
    match v.as_int() {
        case Some(n) {
            return n
        }
        case None {}
    }
    match v.as_string() {
        case Some(s) {
            return match s.trim().parse_int() {
                case Some(n) { n }
                case None { 0 }
            }
        }
        case None {}
    }
    return 0
}
