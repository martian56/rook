// The model's live checklist. set_todos replaces the whole list each call
// (the simplest protocol that cannot drift), one item per line, with a
// leading marker for state: "[x]" done, "[>]" in progress, anything else
// pending. The UI renders the current list as a strip above the input while
// it is non-empty; /clear empties it. A mutex guards the store since the
// tool writes from the turn goroutine and the view reads every frame.

import std.string
from std.sync import Mutex, mutex

// One checklist item: state 0 pending, 1 in progress, 2 done.
class Todo {
    text: str
    state: int
}

class TodoStore {
    lock: Mutex
    items: list[Todo]
}

fun _new_store() -> TodoStore {
    let items: list[Todo] = []
    return TodoStore(lock: mutex(), items: items)
}

let STORE: TodoStore = _new_store()

// The tool: replace the checklist with `text`, one item per line. Returns a
// short confirmation with the counts.
fun set_todos(text: str) -> str {
    let items = parse_todos(text)
    STORE.lock.lock()
    STORE.items = items
    STORE.lock.unlock()
    if items.len() == 0 {
        return "todo list cleared"
    }
    var done = 0
    var i = 0
    while i < items.len() {
        if items[i].state == 2 {
            done = done + 1
        }
        i = i + 1
    }
    return "todo list updated: ${done} of ${items.len()} done"
}

// Parse the line format. Blank lines are skipped; markers are forgiving
// about case and surrounding whitespace.
fun parse_todos(text: str) -> list[Todo] {
    let out: list[Todo] = []
    let lines = text.lines()
    var i = 0
    while i < lines.len() {
        var line = lines[i].trim()
        if line != "" {
            var state = 0
            if line.starts_with("[x]") or line.starts_with("[X]") {
                state = 2
                line = line.substring(3, line.length()).trim()
            } else {
                if line.starts_with("[>]") {
                    state = 1
                    line = line.substring(3, line.length()).trim()
                } else {
                    if line.starts_with("[ ]") {
                        line = line.substring(3, line.length()).trim()
                    }
                }
            }
            if line != "" {
                out.push(Todo(text: line, state: state))
            }
        }
        i = i + 1
    }
    return out
}

// The current list for the view. Returning the stored reference is safe
// because every writer (set_todos, clear_todos) swaps in a freshly built
// list rather than mutating this one in place, and the view runs every
// frame, so it should not pay a copy per redraw.
fun current_todos() -> list[Todo] {
    STORE.lock.lock()
    let out = STORE.items
    STORE.lock.unlock()
    return out
}

fun clear_todos() {
    STORE.lock.lock()
    let none: list[Todo] = []
    STORE.items = none
    STORE.lock.unlock()
    return
}
