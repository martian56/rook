// Pure parsing for the /mcp command's prompt invocation:
// "/mcp prompt <server> <name> [key=value ...]". Values may be quoted
// strings or typed JSON. Complex callers can pass one object after --json.

import std.string
from std.json import JsonValue, parse, stringify
from "github.com/martian56/aviary/jsonutil" import Obj

class McpInvoke {
    server: str
    name: str
    args_json: str
    error: str
}

class TokenResult {
    tokens: list[str]
    error: str
}

class ValueResult {
    ok: bool
    value: JsonValue
    error: str
}

fun parse_invoke(rest: str) -> McpInvoke {
    let tokenized = _tokens(rest)
    if tokenized.error != "" {
        return _failed(tokenized.error)
    }
    let toks = tokenized.tokens
    var server = ""
    var name = ""
    if toks.len() >= 1 {
        server = _name_token(toks[0])
    }
    if toks.len() >= 2 {
        name = _name_token(toks[1])
    }
    if toks.len() <= 2 {
        return McpInvoke(server: server, name: name, args_json: "{}", error: "")
    }

    if toks[2] == "--json" {
        if toks.len() != 4 {
            return _failed("--json needs exactly one JSON object")
        }
        let raw = _strip_single_quotes(toks[3])
        return match parse(raw) {
            case Ok(j) {
                match j {
                    case Object(fields) {
                        McpInvoke(server: server, name: name, args_json: stringify(j), error: "")
                    }
                    case _ { _failed("--json value must be an object") }
                }
            }
            case Err(e) { _failed("invalid --json object: ${e.message}") }
        }
    }

    let obj = Obj.new()
    var i = 2
    while i < toks.len() {
        let eq = toks[i].index_of("=")
        if eq <= 0 {
            return _failed("argument '${toks[i]}' must use key=value")
        }
        let key = toks[i].substring(0, eq).trim()
        if key == "" {
            return _failed("argument keys cannot be empty")
        }
        let raw = toks[i].substring(eq + 1, toks[i].length())
        let parsed = _value(raw)
        if not parsed.ok {
            return _failed("invalid value for '${key}': ${parsed.error}")
        }
        obj.set(key, parsed.value)
        i = i + 1
    }
    return McpInvoke(server: server, name: name, args_json: stringify(obj.build()), error: "")
}

fun _failed(reason: str) -> McpInvoke {
    return McpInvoke(
        server: "",
        name: "",
        args_json: "{}",
        error: "error: invalid MCP prompt arguments: ${reason}",
    )
}

fun _value(raw: str) -> ValueResult {
    if raw == "" {
        return ValueResult(ok: true, value: JsonValue.Str(""), error: "")
    }
    if raw.starts_with("'") {
        return _single_quoted(raw)
    }
    match parse(raw) {
        case Ok(j) {
            return ValueResult(ok: true, value: j, error: "")
        }
        case Err(e) {
            if raw.starts_with("\"") or raw.starts_with("[") or raw.starts_with("{") {
                return ValueResult(ok: false, value: JsonValue.Null, error: e.message)
            }
        }
    }
    return ValueResult(ok: true, value: JsonValue.Str(raw), error: "")
}

fun _single_quoted(raw: str) -> ValueResult {
    if raw.length() < 2 or not raw.ends_with("'") {
        return ValueResult(ok: false, value: JsonValue.Null, error: "unterminated single-quoted string")
    }
    var out = ""
    var i = 1
    while i < raw.length() - 1 {
        let ch = raw.char_at(i)
        if ch == "\\" {
            if i + 1 >= raw.length() - 1 {
                return ValueResult(
                    ok: false,
                    value: JsonValue.Null,
                    error: "trailing escape in single-quoted string",
                )
            }
            let next = raw.char_at(i + 1)
            if next == "'" or next == "\\" {
                out = out.concat(next)
            } else {
                out = out.concat("\\").concat(next)
            }
            i = i + 2
        } else {
            out = out.concat(ch)
            i = i + 1
        }
    }
    return ValueResult(ok: true, value: JsonValue.Str(out), error: "")
}

fun _name_token(raw: str) -> str {
    let parsed = _value(raw)
    if parsed.ok {
        return match parsed.value {
            case Str(s) { s }
            case _ { raw }
        }
    }
    return raw
}

fun _strip_single_quotes(raw: str) -> str {
    if raw.length() >= 2 and raw.starts_with("'") and raw.ends_with("'") {
        return raw.substring(1, raw.length() - 1)
    }
    return raw
}

// Split on whitespace except inside quotes or balanced JSON arrays/objects.
// Quote characters stay in each token so the value parser can preserve type.
fun _tokens(s: str) -> TokenResult {
    let out: list[str] = []
    var cur = ""
    var quote = ""
    var escaped = false
    var depth = 0
    var i = 0
    while i < s.length() {
        let ch = s.char_at(i)
        if quote != "" {
            cur = cur.concat(ch)
            if escaped {
                escaped = false
            } else if ch == "\\" {
                escaped = true
            } else if ch == quote {
                quote = ""
            }
            i = i + 1
            continue
        }
        if ch == "\"" or ch == "'" {
            quote = ch
            cur = cur.concat(ch)
        } else if ch == "[" or ch == "{" {
            depth = depth + 1
            cur = cur.concat(ch)
        } else if ch == "]" or ch == "}" {
            depth = depth - 1
            if depth < 0 {
                return TokenResult(tokens: out, error: "unexpected '${ch}'")
            }
            cur = cur.concat(ch)
        } else if _space(ch) and depth == 0 {
            if cur != "" {
                out.push(cur)
                cur = ""
            }
        } else {
            cur = cur.concat(ch)
        }
        i = i + 1
    }
    if quote != "" {
        return TokenResult(tokens: out, error: "unterminated ${quote} quote")
    }
    if depth != 0 {
        return TokenResult(tokens: out, error: "unclosed JSON array or object")
    }
    if cur != "" {
        out.push(cur)
    }
    return TokenResult(tokens: out, error: "")
}

fun _space(ch: str) -> bool {
    return ch == " " or ch == "\t" or ch == "\n" or ch == "\r"
}
