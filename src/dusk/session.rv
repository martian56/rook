// rook inside the dusk editor: `rook --dusk` speaks dusk's plugin protocol
// (JSON-RPC lines on stdin and stdout) and runs the same agent turn as print
// mode, shown in a dusk chat panel. Approvals and questions are asked with
// dusk pickers.

import std.string
from std.io import read_line, print
from "github.com/martian56/aviary/message" import Message
from std.json import JsonValue, parse, stringify, json_int, json_string, json_object, json_array
from std.sync import Mutex, mutex, sleep_millis
from std.time import now_millis
from "../agent/state" import AgentState, DisplayEvent
from "../agent/turn" import run_turn
from "../ui/transcript" import Entry
from "../tools/mentions" import expand_mentions
from "../tools/shells" import refresh, shells_snapshot
from "../tools/checkpoints" import current_batch_files, rewind_last_batch
from "../tools/clipboard" import copy_to_clipboard, ClipResult
from "../agent/compact" import force_compact
from "../agents/commands" import cached_commands, find_expansion, command_infos
from "../agents/dir" import roots
from "../commands" import builtin_commands, CmdInfo, INIT_PROMPT
from "../config/catalog" import catalog
from std.fs import write
from std.env import os_name
from "../config/sessions" import (
    new_session_id,
    save_session_async,
    list_sessions_result,
    load_session,
    session_cwd,
    same_dir,
)
from "../config/config" import (
    resolve_model,
    resolve_base,
    resolve_key,
    key_needed_with,
    provider_of,
    save_model,
    model_source,
    key_source,
)

let PANEL = "chat"
let MAX_TRANSCRIPT = 12000
let PANEL_EVERY_MS = 100

fun obj(pairs: list[(str, JsonValue)]) -> JsonValue {
    let m: dict[str, JsonValue] = {}
    for (k, v) in pairs {
        m.set(k, v)
    }
    return json_object(m)
}

fun jstr(s: str) -> JsonValue = json_string(s)

fun jint(n: int) -> JsonValue = json_int(n)

fun field(v: JsonValue, key: str) -> str {
    return match v.get(key) {
        case Some(x) { x.as_string().unwrap_or("") }
        case None { "" }
    }
}

fun int_field(v: JsonValue, key: str, default: int) -> int {
    return match v.get(key) {
        case Some(x) { x.as_int().unwrap_or(default) }
        case None { default }
    }
}

// Where protocol lines go: stdout, or memory for tests. Both the reader and
// the pump goroutine write, so lines are written whole under a lock.
class Wire {
    lock: Mutex
    real: bool
    written: list[str] = []
}

fun stdout_wire() -> Wire = Wire(lock: mutex(), real: true)

fun memory_wire() -> Wire = Wire(lock: mutex(), real: false)

impl Wire {
    fun send(self, pairs: list[(str, JsonValue)]) {
        let all: list[(str, JsonValue)] = [("jsonrpc", jstr("2.0"))]
        for p in pairs {
            all.push(p)
        }
        let line = stringify(obj(all))
        self.lock.lock()
        if self.real {
            print(line + "\n")
        } else {
            self.written.push(line)
        }
        self.lock.unlock()
    }

    fun lines(self) -> list[str] {
        self.lock.lock()
        let out = self.written.copy()
        self.lock.unlock()
        return out
    }
}

class DuskSession {
    wire: Wire
    lock: Mutex
    st: AgentState
    model: str
    api_key: str
    base_url: str
    transcript: str = ""
    in_reply: bool = false
    running: bool = false
    panel_open: bool = false
    changed: bool = false
    last_sent: int = 0
    next_id: int = 1
    // Request id -> what the answer is for: "approve", "question", or "ask".
    waiting: dict[int, str] = {}
    asking: bool = false
    approval: str = ""
    approval_detail: str = ""
    // The selection an ask_about_selection prompt is about.
    context: str = ""
    open_paths: list[str] = []
    quit: bool = false
    // The session as the terminal UI saves it, so `rook --continue` and
    // rook.resume pick a dusk chat back up.
    session_id: str = new_session_id()
    entries: list[Entry] = []
    // Prompts sent while a turn was running, started in order after it.
    queued: list[str] = []
    // Background shells running at the last check, and those already seen
    // finished, so each finish is noticed once even if it never ran during a
    // check.
    shells_running: list[int] = []
    shells_done: list[int] = []
    shells_checked: int = 0
    // Files this turn changed, as (path, created), for the panel's list, and
    // those whose pre-turn text dusk already has as a change baseline.
    changed_files: list[(str, bool)] = []
    based: list[str] = []
    // What the open picker is choosing between.
    choices: list[str] = []
    // A /compact summary is being written; the conversation must not be
    // replaced or extended until it lands.
    compacting: bool = false
}

fun new_session(wire: Wire, model: str, api_key: str, base_url: str) -> DuskSession {
    return DuskSession(
        wire: wire,
        lock: mutex(),
        st: AgentState.new(),
        model: model,
        api_key: api_key,
        base_url: base_url,
    )
}

fun contributions() -> JsonValue {
    let cmds = [
        obj([("name", jstr("rook.chat")), ("title", jstr("Open the rook chat panel"))]),
        obj(
            [
                ("name", jstr("rook.ask_about_selection")),
                ("title", jstr("Ask rook about the selection")),
            ],
        ),
        obj([("name", jstr("rook.stop")), ("title", jstr("Stop rook's current turn"))]),
        obj(
            [
                ("name", jstr("rook.resume")),
                ("title", jstr("Continue this project's last rook session")),
            ],
        ),
        obj([("name", jstr("rook.new")), ("title", jstr("Start a new rook conversation"))]),
    ]
    let binds = [
        obj([("mode", jstr("normal")), ("keys", jstr("space r")), ("command", jstr("rook.chat"))]),
        obj(
            [
                ("mode", jstr("visual")),
                ("keys", jstr("space r")),
                ("command", jstr("rook.ask_about_selection")),
            ],
        ),
    ]
    return obj(
        [("name", jstr("rook")), ("commands", json_array(cmds)), ("bindings", json_array(binds))],
    )
}

impl DuskSession {
    fun reply(self, id: int, result: JsonValue) {
        self.wire.send([("id", jint(id)), ("result", result)])
    }

    fun reply_error(self, id: int, message: str) {
        self.wire.send(
            [
                ("id", jint(id)),
                ("error", obj([("code", jint(0 - 32000)), ("message", jstr(message))])),
            ],
        )
    }

    fun notify(self, method: str, params: JsonValue) {
        self.wire.send([("method", jstr(method)), ("params", params)])
    }

    fun request(self, method: str, params: JsonValue, purpose: str) {
        let id = self.next_id
        self.next_id += 1
        self.waiting.set(id, purpose)
        self.wire.send([("id", jint(id)), ("method", jstr(method)), ("params", params)])
    }

    fun message(self, text: str) {
        self.notify("ui/message", obj([("text", jstr(text))]))
    }

    fun note(self, md: str) {
        self.transcript += md
        self.in_reply = false
        self.changed = true
        self.trim_transcript()
    }

    // Keep only what the panel can show, so a long session does not grow
    // the copy on every chunk. The model's conversation is untouched.
    fun trim_transcript(self) {
        if self.transcript.length() > 2 * MAX_TRANSCRIPT {
            let t = self.transcript
            self.transcript = t.substring(char_start(t, t.length() - MAX_TRANSCRIPT), t.length())
        }
    }

    // Whether the conversation is busy with a turn or a /compact; says so.
    fun busy(self, what: str) -> bool {
        if self.compacting {
            self.message("rook is compacting the conversation; ${what} after it finishes")
            return true
        }
        return false
    }

    // Start a turn with `text`, unless one is running.
    fun start_turn(self, text: str) {
        self.panel_open = true
        self.changed = true
        if self.busy("send it") {
            return
        }
        if self.running {
            self.queued.push(text)
            self.note("\n\n_queued: ${text}_\n\n")
            return
        }
        if key_needed_with(self.model, self.api_key) {
            self.note(
                "\n\n**No API key for ${provider_of(self.model)}.** Set its environment variable, or run rook in a terminal once and use /key.\n\n",
            )
            return
        }
        self.note("\n\n**You:** ${text}\n\n")
        self.changed_files = []
        self.based = []
        self.entries.push(Entry.UserMsg(text))
        // @path mentions attach the file, as in the terminal.
        self.st.push_user(expand_mentions(text))
        self.st.begin()
        self.running = true
        let st = self.st
        let model = self.model
        let key = self.api_key
        let base = self.base_url
        spawn {
            run_turn(st, model, key, base)
        }
    }

    // Save the session, show its token use, and start a queued prompt.
    fun turn_finished(self, prompt_tokens: int, completion_tokens: int) {
        save_session_async(
            self.session_id,
            self.model,
            self.entries.copy(),
            self.st.messages(),
            prompt_tokens,
            completion_tokens,
        )
        self.show_tokens(prompt_tokens + completion_tokens)
        if len(self.queued) > 0 {
            let next = self.queued.remove_at(0)
            self.start_turn(next)
        }
    }

    fun show_tokens(self, n: int) {
        self.notify(
            "status/set",
            obj([("id", jstr("tokens")), ("text", jstr("rook ${tokens_text(n)}"))]),
        )
    }

    // A background shell that finished may have written files.
    fun check_shells(self) {
        refresh()
        let running: list[int] = []
        var finished = false
        for sh in shells_snapshot() {
            if sh.running {
                running.push(sh.id)
            } else if not self.shells_done.contains(sh.id) {
                self.shells_done.push(sh.id)
                finished = true
            }
        }
        self.shells_running = running
        if finished and len(self.open_paths) > 0 {
            self.notify("files/changed", obj([("paths", json_array(self.open_paths.map(p => jstr(p))))]))
        }
    }

    // Load the newest session saved from this directory, from the terminal
    // or from dusk.
    fun resume(self) {
        if self.running {
            self.message("rook is working; stop it before resuming another session")
            return
        }
        let here = session_cwd()
        var id = ""
        for meta in list_sessions_result().sessions {
            if id == "" and same_dir(meta.cwd, here) {
                id = meta.id
            }
        }
        if id == "" {
            self.message("no saved rook session for this directory")
            return
        }
        self.load_id(id)
    }

    // Load saved session `id` into the panel and the conversation.
    fun load_id(self, id: str) {
        if self.busy("resume one") {
            return
        }
        let l = load_session(id)
        if l.error != "" {
            self.message(l.error)
            return
        }
        self.session_id = id
        self.entries = l.entries
        self.st.replace_convo(l.messages)
        self.st.set_usage(l.usage_prompt, l.usage_completion)
        self.transcript = transcript_of(l.entries)
        self.in_reply = false
        self.panel_open = true
        self.changed = true
        self.last_sent = 0
        self.show_tokens(l.usage_prompt + l.usage_completion)
        self.message("resumed a rook session (${len(l.messages)} messages)")
    }

    fun new_conversation(self) {
        if self.running {
            self.message("rook is working; stop it first")
            return
        }
        if self.busy("start a new one") {
            return
        }
        self.session_id = new_session_id()
        let none: list[Entry] = []
        self.entries = none
        let empty: list[Message] = []
        self.st.replace_convo(empty)
        self.transcript = ""
        self.queued = []
        self.st.set_usage(0, 0)
        self.show_tokens(0)
        self.panel_open = true
        self.changed = true
        self.last_sent = 0
    }

    fun stop(self) {
        self.queued = []
        if self.running {
            self.st.request_interrupt()
            self.release_ask()
        }
    }

    // Drop the approval or question on screen: its picker's answer, if dusk
    // still sends one, is ignored, and the waiting turn gets a refusal. Only
    // a turn that is actually waiting is answered, so a decision can never
    // be left behind for a later prompt.
    fun release_ask(self) {
        // The turn may have published its prompt before the pump sent the
        // picker, so answer from the state, not from what dusk was shown.
        for id in self.waiting.keys() {
            let purpose = self.waiting.get(id).unwrap_or("")
            if purpose == "approve" or purpose == "question" {
                let _ = self.waiting.remove(id)
            }
        }
        self.asking = false
        self.approval = ""
        self.approval_detail = ""
        self.changed = true
        if self.st.pending_now() != "" {
            self.st.decide(0)
        } else if self.st.question_now() != "" {
            self.st.decide(0 - 1)
        }
    }

    // One line from dusk.
    fun handle(self, line: str) {
        let v = match parse(line) {
            case Ok(x) { x }
            case Err(e) {
                return
            }
        }
        self.lock.lock()
        self.handle_locked(v)
        self.lock.unlock()
    }

    fun handle_locked(self, v: JsonValue) {
        let method = field(v, "method")
        let id = int_field(v, "id", 0 - 1)
        let params = v.get("params").unwrap_or(JsonValue.Null)
        if method == "" {
            match self.waiting.get(id) {
                case Some(purpose) {
                    let _ = self.waiting.remove(id)
                    self.answered(purpose, v.get("result").unwrap_or(JsonValue.Null))
                }
                case None {}
            }
            return
        }
        if method == "initialize" {
            self.reply(id, contributions())
        } else if method == "shutdown" {
            self.reply(id, obj([]))
            self.stop()
            self.quit = true
        } else if method == "command/run" {
            self.command(id, field(params, "command"), params)
        } else if method == "buffer/opened" {
            let p = field(params, "path")
            if p != "" and not self.open_paths.contains(p) {
                self.open_paths.push(p)
            }
        } else if method == "buffer/closed" {
            let p = field(params, "path")
            self.open_paths = self.open_paths.filter(x => x != p)
        } else if method == "ui/event" and field(params, "panel") == PANEL {
            let kind = field(params, "kind")
            if kind == "submit" {
                let text = match params.get("value") {
                    case Some(x) { x.as_string().unwrap_or("") }
                    case None { "" }
                }
                if text.trim().starts_with("/") {
                    self.slash(text.trim())
                } else if text.trim() != "" {
                    self.start_turn(text.trim())
                }
            } else if kind == "choose" and field(params, "block") == "changed" {
                let i = int_field(params, "value", 0 - 1)
                if i >= 0 and i < len(self.changed_files) {
                    self.request(
                        "buffer/open",
                        obj([("path", jstr(self.changed_files[i].0)), ("line", jint(1))]),
                        "open",
                    )
                }
            } else if kind == "press" {
                self.stop()
            } else if kind == "closed" {
                self.panel_open = false
            }
        } else if id >= 0 {
            self.reply_error(id, "rook does not handle ${method}")
        }
    }

    fun command(self, id: int, name: str, params: JsonValue) {
        if name == "rook.chat" {
            self.panel_open = true
            self.changed = true
            self.last_sent = 0
            self.reply(id, obj([]))
        } else if name == "rook.stop" {
            self.queued = []
            self.stop()
            self.reply(id, obj([]))
        } else if name == "rook.resume" {
            self.resume()
            self.reply(id, obj([]))
        } else if name == "rook.new" {
            self.new_conversation()
            self.reply(id, obj([]))
        } else if name == "rook.ask_about_selection" {
            let sel = field(params, "selection")
            self.reply(id, obj([]))
            if sel.trim() == "" {
                self.message("select some code first, then run rook.ask_about_selection")
                return
            }
            let path = field(params, "path")
            self.context = "In ${path if path != "" else "the current buffer"}:\n\n```\n${sel}\n```\n\n"
            self.request("ui/prompt", obj([("title", jstr("Ask rook")), ("text", jstr(""))]), "ask")
        } else {
            self.reply_error(id, "rook has no command ${name}")
        }
    }

    fun answered(self, purpose: str, result: JsonValue) {
        if purpose == "open" {
            return
        }
        if purpose == "model" or purpose == "session" or purpose == "theme" {
            let i = int_field(result, "index", 0 - 1)
            if i < 0 or i >= len(self.choices) {
                return
            }
            let pick = self.choices[i]
            if purpose == "model" {
                self.set_model(pick)
            } else if purpose == "session" {
                self.load_id(pick)
            } else {
                self.notify("theme/set", obj([("name", jstr(pick))]))
            }
            return
        }
        if purpose == "themes" {
            let names: list[str] = []
            let labels: list[JsonValue] = []
            match result.get("themes") {
                case Some(v) {
                    match v {
                        case Array(items) {
                            for it in items {
                                names.push(field(it, "name"))
                                labels.push(
                                    obj([("label", jstr(field(it, "name"))), ("detail", jstr(field(it, "description")))]),
                                )
                            }
                        }
                        case _ {}
                    }
                }
                case None {}
            }
            self.choices = names
            self.request(
                "ui/pick",
                obj(
                    [
                        ("title", jstr("dusk theme (now ${field(result, "current")})")),
                        ("items", json_array(labels)),
                    ],
                ),
                "theme",
            )
            return
        }
        if purpose == "ask" {
            let text = field(result, "text")
            if result.get("cancelled").is_none() and text.trim() != "" {
                self.start_turn(self.context + text.trim())
            }
            self.context = ""
            return
        }
        self.asking = false
        let index = int_field(result, "index", 0 - 1)
        if purpose == "approve" {
            self.approval = ""
            self.approval_detail = ""
            self.changed = true
            // Allow, allow all of this kind, deny; dismissing denies.
            if self.st.pending_now() != "" {
                self.st.decide(1 if index == 0 else (2 if index == 1 else 0))
            }
        } else if purpose == "question" {
            if self.st.question_now() != "" {
                self.st.decide(index)
            }
        }
    }

    fun apply_event(self, e: DisplayEvent) -> bool {
        match e {
            case Chunk(d) {
                if not self.in_reply {
                    self.transcript += "**rook:** "
                    self.in_reply = true
                    self.entries.push(Entry.BotMsg(""))
                }
                let last = len(self.entries) - 1
                match self.entries[last] {
                    case BotMsg(t) {
                        self.entries[last] = Entry.BotMsg(t + d)
                    }
                    case _ {}
                }
                self.transcript += d
                self.changed = true
                self.trim_transcript()
            }
            case ToolRan(label, result) {
                self.entries.push(Entry.ToolMsg(label, result))
                self.note("\n\n`${label}`\n\n")
                return changes_files(label)
            }
            case Info(t) {
                self.entries.push(Entry.Notice(t))
                self.note("\n\n_${t}_\n\n")
            }
            case AgentStarted(id, name) { self.note("\n\n_${name} agent started_\n\n") }
            case AgentFinished(id, name, used) {
                self.note("\n\n_${name} agent done, ${used} tools_\n\n")
            }
            case _ {}
        }
        return false
    }

    // Drain the turn and keep dusk up to date. Called every 50 ms.
    fun pump(self, now_ms: int) {
        self.lock.lock()
        if self.running {
            let snap = self.st.drain()
            var touched = false
            for e in snap.events {
                if self.apply_event(e) {
                    touched = true
                }
            }
            if touched {
                self.report_changes()
            }
            if snap.pending != "" and not self.asking {
                self.asking = true
                self.approval = snap.pending
                self.approval_detail = snap.pending_detail
                self.changed = true
                let items = json_array([jstr("Allow"), jstr("Allow all of this kind"), jstr("Deny")])
                self.request(
                    "ui/pick",
                    obj([("title", jstr("rook wants to run ${snap.pending}")), ("items", items)]),
                    "approve",
                )
            } else if snap.question != "" and not self.asking {
                self.asking = true
                let choices = snap.choices if len(snap.choices) > 0 else ["OK"]
                let items = json_array(choices.map(c => jstr(c)))
                self.request("ui/pick", obj([("title", jstr(snap.question)), ("items", items)]), "question")
            }
            if snap.done {
                self.running = false
                self.in_reply = false
                self.changed = true
                self.turn_finished(snap.sess_prompt, snap.sess_completion)
            }
        }
        if now_ms - self.shells_checked >= 1000 {
            self.shells_checked = now_ms
            self.check_shells()
        }
        if self.changed and self.panel_open and now_ms - self.last_sent >= PANEL_EVERY_MS {
            self.changed = false
            self.last_sent = now_ms
            self.notify("ui/panel", self.panel())
        }
        self.lock.unlock()
    }

    // Tell dusk what this turn changed: each touched file's text from before
    // the turn becomes its change baseline (sent once, before the reload, so
    // dusk highlights exactly what rook did), then the changed and open files
    // reload. A command or background shell may have changed open files too.
    fun report_changes(self) {
        let paths: list[str] = []
        for snap in current_batch_files() {
            let p = dusk_path(snap.path)
            // A skipped checkpoint (a huge or unreadable file) has no known
            // pre-turn text, so it gets no baseline: an empty one would mark
            // every line as added.
            if not self.based.contains(p) and snap.skipped == "" {
                self.based.push(p)
                self.notify(
                    "changes/baseline",
                    obj([("path", jstr(p)), ("text", jstr(snap.content if snap.existed else ""))]),
                )
            }
            if not self.changed_files.any(c => c.0 == p) {
                self.changed_files.push((p, not snap.existed))
                self.changed = true
            }
            paths.push(p)
        }
        for p in self.open_paths {
            if not paths.contains(p) {
                paths.push(p)
            }
        }
        if len(paths) > 0 {
            self.notify("files/changed", obj([("paths", json_array(paths.map(p => jstr(p))))]))
        }
    }

    // A /command typed in the chat box.
    fun slash(self, text: str) {
        let sp = text.index_of(" ")
        let name = (text.substring(1, sp) if sp > 0 else text.substring(1, text.length())).to_lower()
        let arg = text.substring(sp + 1, text.length()).trim() if sp > 0 else ""
        self.panel_open = true
        self.changed = true
        if name == "help" {
            var md = "\n\n**Commands**\n\n"
            for c in dusk_commands() {
                md += "- `/${c.name}` ${c.desc}\n"
            }
            for c in command_infos(cached_commands(roots())) {
                md += "- `/${c.name}` ${c.desc}\n"
            }
            self.note(md + "\n")
        } else if name == "model" {
            if arg != "" {
                self.set_model(arg)
            } else {
                self.choices = catalog()
                let items = self.choices.map(
                    m => obj([("label", jstr(m)), ("detail", jstr("current" if m == self.model else ""))]),
                )
                self.request(
                    "ui/pick",
                    obj([("title", jstr("Model (now ${self.model})")), ("items", json_array(items))]),
                    "model",
                )
            }
        } else if name == "sessions" or name == "resume" {
            self.pick_session()
        } else if name == "clear" or name == "new" {
            self.new_conversation()
            self.note("_new conversation; the previous one is in /sessions_\n\n")
        } else if name == "stop" {
            self.queued = []
            self.stop()
        } else if name == "plan" {
            let on = not self.st.plan()
            self.st.set_plan(on)
            self.note(
                "\n\n_plan mode ${"on: rook researches and proposes, and changes nothing" if on else "off"}_\n\n",
            )
        } else if name == "status" {
            let on = "on" if self.st.plan() else "off"
            self.note(
                "\n\n**Status**\n\n- model: `${self.model}` (from ${model_source()})\n- key: from ${key_source(self.model)}\n- plan mode: ${on}\n- session: `${self.session_id}`, ${len(self.entries)} entries\n- directory: `${session_cwd()}`\n\n",
            )
        } else if name == "compact" {
            self.compact()
        } else if name == "rewind" {
            if self.busy("rewind") {
                return
            }
            if self.running {
                self.message("rook is working; stop it before rewinding")
                return
            }
            self.note("\n\n_${rewind_last_batch()}_\n\n")
            self.report_rewind()
        } else if name == "init" {
            self.start_turn_as(text, INIT_PROMPT)
        } else if name == "copy" {
            self.copy_last()
        } else if name == "export" {
            let target = arg if arg != "" else "rook-session-${self.session_id}.md"
            match write(target, self.transcript.trim() + "\n") {
                case Ok(ok) { self.note("\n\n_exported the conversation to ${target}_\n\n") }
                case Err(e) { self.note("\n\n_could not write ${target}: ${e.message}_\n\n") }
            }
        } else if name == "shells" {
            refresh()
            var md = "\n\n**Background shells**\n\n"
            let shells = shells_snapshot()
            for sh in shells {
                md += "- #${sh.id} `${sh.command}`: ${"running" if sh.running else "exited ${sh.code}"}\n"
            }
            self.note(md + ("_none_\n\n" if len(shells) == 0 else "\n"))
        } else if name == "theme" {
            self.notify("theme/set", obj([("name", jstr(arg))])) if arg != "" else self.request("theme/list", obj([]), "themes")
        } else if name == "quit" or name == "exit" {
            self.message("rook stops with dusk; Esc leaves the chat panel")
        } else if name == "key" or name == "login" or name == "permissions" or name == "plugins" or name == "mcp" {
            self.note("\n\n_/${name} needs rook in a terminal; what it sets applies here too_\n\n")
        } else {
            let exp = find_expansion(cached_commands(roots()), text)
            self.start_turn_as(text, exp) if exp != "" else self.note("\n\n_unknown command ${text}; /help lists them_\n\n")
        }
    }

    // Start a turn that shows `shown` but sends `prompt`.
    fun start_turn_as(self, shown: str, prompt: str) {
        if self.running {
            self.queued.push(prompt)
            self.note("\n\n_queued: ${shown}_\n\n")
            return
        }
        self.start_turn(prompt)
    }

    fun set_model(self, model: str) {
        if self.running {
            self.message("rook is working; switch models after this turn")
            return
        }
        self.model = model
        self.api_key = resolve_key(model)
        let err = save_model(model)
        self.note("\n\n_model: ${model}${"" if err == "" else " (" + err + ")"}_\n\n")
    }

    fun pick_session(self) {
        if self.running {
            self.message("rook is working; stop it before resuming another session")
            return
        }
        let here = session_cwd()
        let ids: list[str] = []
        let items: list[JsonValue] = []
        for meta in list_sessions_result().sessions {
            if same_dir(meta.cwd, here) {
                ids.push(meta.id)
                items.push(
                    obj(
                        [
                            ("label", jstr(meta.title if meta.title != "" else meta.id)),
                            ("detail", jstr(meta.model)),
                        ],
                    ),
                )
            }
        }
        if len(ids) == 0 {
            self.message("no saved rook session for this directory")
            return
        }
        self.choices = ids
        self.request(
            "ui/pick",
            obj([("title", jstr("Resume a session")), ("items", json_array(items))]),
            "session",
        )
    }

    // Summarize older turns on a goroutine; the result shows when it is done.
    fun compact(self) {
        if self.running {
            self.message("rook is working; compact after this turn")
            return
        }
        if self.busy("compact again") {
            return
        }
        if key_needed_with(self.model, self.api_key) {
            self.note("\n\n_no API key for ${provider_of(self.model)}_\n\n")
            return
        }
        self.note("\n\n_compacting the conversation…_\n\n")
        self.compacting = true
        let me = self
        let st = self.st
        let model = self.model
        let key = self.api_key
        let base = self.base_url
        spawn {
            let folded = force_compact(st, model, key, base)
            me.lock.lock()
            me.compacting = false
            me.note(
                "_compacted ${folded} earlier messages into a summary_\n\n" if folded > 0 else "_nothing to compact yet_\n\n",
            )
            me.lock.unlock()
        }
    }

    fun copy_last(self) {
        var last = ""
        for e in self.entries {
            match e {
                case BotMsg(t) {
                    last = t
                }
                case _ {}
            }
        }
        if last == "" {
            self.message("no reply to copy yet")
            return
        }
        match copy_to_clipboard(last) {
            case Failed { self.message("could not reach the clipboard") }
            case _ { self.message("copied rook's last reply") }
        }
    }

    // After /rewind the files are back; reload them and drop the highlights.
    fun report_rewind(self) {
        let paths: list[str] = []
        for c in self.changed_files {
            paths.push(c.0)
            self.notify("changes/baseline", obj([("path", jstr(c.0))]))
        }
        for p in self.open_paths {
            if not paths.contains(p) {
                paths.push(p)
            }
        }
        self.changed_files = []
        self.based = []
        if len(paths) > 0 {
            self.notify("files/changed", obj([("paths", json_array(paths.map(p => jstr(p))))]))
        }
    }

    fun shown_transcript(self) -> str {
        let t = self.transcript.trim()
        if t == "" {
            return "Ask rook anything about this project. Enter sends, Ctrl+N adds a line, and /help lists commands such as /model, /sessions, and /plan."
        }
        if t.length() <= MAX_TRANSCRIPT {
            return t
        }
        let tail = t.substring(char_start(t, t.length() - MAX_TRANSCRIPT), t.length())
        let cut = tail.index_of("\n\n")
        return "_(earlier messages hidden)_\n\n" + (tail.substring(cut + 2, tail.length()) if cut >= 0 else tail)
    }

    fun panel(self) -> JsonValue {
        let blocks: list[JsonValue] = [
            obj(
                [
                    ("id", jstr("transcript")),
                    ("kind", jstr("text")),
                    ("text", jstr(self.shown_transcript())),
                ],
            ),
        ]
        if self.approval != "" {
            var md = "**Waiting for your approval:** ${self.approval}"
            if self.approval_detail != "" {
                md += "\n\n```\n${self.approval_detail}\n```"
            }
            blocks.push(obj([("id", jstr("approval")), ("kind", jstr("text")), ("text", jstr(md))]))
        }
        if self.running {
            blocks.push(
                obj([("id", jstr("busy")), ("kind", jstr("progress")), ("text", jstr("rook is working"))]),
            )
            blocks.push(
                obj([("id", jstr("act")), ("kind", jstr("buttons")), ("items", json_array([jstr("Stop")]))]),
            )
        }
        if len(self.changed_files) > 0 {
            blocks.push(
                obj(
                    [
                        ("id", jstr("changed-head")),
                        ("kind", jstr("text")),
                        ("text", jstr("**Changed this turn** (Enter opens one; ] c jumps to changes)")),
                    ],
                ),
            )
            let rows = self.changed_files.map(
                c => obj([("label", jstr(c.0)), ("detail", jstr("new file" if c.1 else "edited"))]),
            )
            blocks.push(obj([("id", jstr("changed")), ("kind", jstr("list")), ("items", json_array(rows))]))
        }
        blocks.push(obj([("id", jstr("ask")), ("kind", jstr("input")), ("text", jstr(""))]))
        return obj(
            [
                ("id", jstr(PANEL)),
                ("title", jstr("rook")),
                ("dock", jstr("right")),
                ("blocks", json_array(blocks)),
            ],
        )
    }

    fun done(self) -> bool {
        self.lock.lock()
        let q = self.quit
        self.lock.unlock()
        return q
    }
}

// The commands the dusk chat box understands, for /help.
fun dusk_commands() -> list[CmdInfo] {
    let skip = ["theme", "permissions", "plugins", "mcp", "key", "quit"]
    let out: list[CmdInfo] = []
    for c in builtin_commands() {
        if not skip.contains(c.name) {
            out.push(c)
        }
    }
    out.push(CmdInfo(name: "theme", desc: "switch dusk's theme; /theme <name> sets one"))
    out.push(CmdInfo(name: "stop", desc: "stop the current turn"))
    out.push(CmdInfo(name: "new", desc: "start a new conversation"))
    return out
}

// A path as dusk names files: forward slashes, relative to the directory
// both run in, without a leading "./".
fun dusk_path(p: str) -> str {
    var out = p.replace("\\", "/")
    let here = session_cwd().replace("\\", "/")
    // Paths compare without case only where the file system ignores it.
    let fold = os_name() == "windows"
    let inside = (out.to_lower().starts_with(here.to_lower() + "/")) if fold else out.starts_with(here + "/")
    if here != "" and inside {
        out = out.substring(here.length() + 1, out.length())
    }
    while out.starts_with("./") {
        out = out.substring(2, out.length())
    }
    return out
}

// Tools whose run can change files on disk, by their label's name.
fun changes_files(label: str) -> bool {
    for name in [
        "write_file",
        "edit_file",
        "multi_edit",
        "run_command",
        "run_background",
        "dispatch",
        "git_commit",
    ] {
        if label.starts_with(name) {
            return true
        }
    }
    return false
}

// The byte offset of the first whole character at or after `at`.
fun char_start(s: str, at: int) -> int {
    var i = max(0, at)
    while i < s.length() and s.byte_at(i) >= 128 and s.byte_at(i) < 192 {
        i += 1
    }
    return i
}

fun tokens_text(n: int) -> str {
    if n >= 1000 {
        return "${n / 1000}.${(n % 1000) / 100}k tok"
    }
    return "${n} tok"
}

// A saved session's entries as the panel's markdown.
fun transcript_of(entries: list[Entry]) -> str {
    var out = ""
    for e in entries {
        match e {
            case UserMsg(t) {
                out += "\n\n**You:** ${t}\n\n"
            }
            case BotMsg(t) {
                out += "**rook:** ${t}"
            }
            case ToolMsg(name, result) {
                out += "\n\n`${name}`\n\n"
            }
            case Notice(t) {
                out += "\n\n_${t}_\n\n"
            }
            case _ {}
        }
    }
    return out
}

fun pump_loop(s: DuskSession) {
    while not s.done() {
        s.pump(now_millis())
        sleep_millis(50)
    }
}

// `rook --dusk`: serve dusk until it shuts rook down or closes the pipe.
fun run_dusk() {
    let model = resolve_model()
    let s = new_session(stdout_wire(), model, resolve_key(model), resolve_base())
    spawn {
        pump_loop(s)
    }
    while not s.done() {
        let line = read_line()
        if line == "" {
            break
        }
        s.handle(line)
    }
    s.lock.lock()
    s.stop()
    s.quit = true
    s.lock.unlock()
    return
}
