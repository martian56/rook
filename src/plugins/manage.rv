// The user-facing side of plugins: the /plugins command. list shows the
// installed plugins and what each contributes; add installs from a git URL
// (optionally at a tag); remove deletes one; update re-installs from the
// recorded source. Each returns a text result the UI shows as notices.

import std.string
from std.env import os_name
from std.fs import is_dir, list_dir
from std.process import run, Output
from "./model" import Plugin, installed_plugins, plugin_path, valid_plugin_name
from "./install" import install_plugin, plugin_source
from "./market" import browse_text, resolve_name_result
from "../agents/dir" import invalidate_roots
from "../agents/commands" import invalidate_commands

// Dispatch a /plugins invocation. The argument is what followed the command
// ("" or "list", "add <url> [tag]", "remove <name>", "update <name>").
fun run_plugins_command(args: str) -> str {
    let a = args.trim()
    if a == "" or a == "list" {
        return list_text()
    }
    var verb = a
    var rest = ""
    let sp = a.index_of(" ")
    if sp >= 0 {
        verb = a.substring(0, sp)
        rest = a.substring(sp + 1, a.length()).trim()
    }
    if verb == "add" {
        let r = add(rest)
        invalidate_roots()
        invalidate_commands()
        return r
    }
    if verb == "remove" or verb == "rm" {
        let r = remove(rest)
        invalidate_roots()
        invalidate_commands()
        return r
    }
    if verb == "update" {
        let r = update(rest)
        invalidate_roots()
        invalidate_commands()
        return r
    }
    if verb == "browse" or verb == "search" {
        return browse_text(rest)
    }
    return "unknown /plugins command '${verb}'; try: list, browse [query], add <git-url or name> [tag], remove <name>, update <name>"
}

// The installed plugins, one line each with version and contributions.
fun list_text() -> str {
    let plugins = installed_plugins()
    if plugins.len() == 0 {
        return "no plugins installed. add one with /plugins add <git-url>"
    }
    var out = ""
    var i = 0
    while i < plugins.len() {
        let p = plugins[i]
        var v = p.version
        if v == "" {
            v = "unversioned"
        }
        var line = "${p.name} ${v}"
        if p.description != "" {
            line = "${line} - ${p.description}"
        }
        let c = contrib(p.path)
        if c != "" {
            line = "${line}  [${c}]"
        }
        if i > 0 {
            out = out.concat("\n")
        }
        out = out.concat(line)
        i = i + 1
    }
    return out
}

// A summary of what a plugin bundle contributes, by counting the entries in
// its .agents-style subfolders. "" when it contributes nothing.
fun contrib(path: str) -> str {
    let parts: list[str] = []
    _add_count(parts, path, "skills", "skills")
    _add_count(parts, path, "subagents", "subagents")
    _add_count(parts, path, "commands", "commands")
    _add_count(parts, path, "themes", "themes")
    var out = ""
    var i = 0
    while i < parts.len() {
        if i > 0 {
            out = out.concat(", ")
        }
        out = out.concat(parts[i])
        i = i + 1
    }
    return out
}

fun add(rest: str) -> str {
    if rest == "" {
        return "usage: /plugins add <git-url or index-name> [tag]"
    }
    var first = rest
    var ref = ""
    let sp = rest.index_of(" ")
    if sp >= 0 {
        first = rest.substring(0, sp)
        ref = rest.substring(sp + 1, rest.length()).trim()
    }
    // A bare name (no path or scheme) is looked up in the marketplace index;
    // anything with a slash or scheme is treated as a git URL directly.
    var url = first
    if not _is_url(first) {
        let resolved = resolve_name_result(first)
        if resolved.error != "" {
            return resolved.error
        }
        url = resolved.url
        if url == "" {
            return "no plugin '${first}' in the index; give a git URL, or try /plugins browse"
        }
    }
    return install_plugin(url, ref)
}

fun _is_url(s: str) -> bool {
    return s.contains("/") or s.contains("://") or s.starts_with("git@")
}

fun remove(name: str) -> str {
    if name == "" {
        return "usage: /plugins remove <name>"
    }
    if not valid_plugin_name(name) {
        return "error: unsafe plugin name: ${name}"
    }
    let path = plugin_path(name)
    if path == "" or not is_dir(path) {
        return "no plugin named ${name}; /plugins list shows what is installed"
    }
    let err = _rmtree(path)
    if err != "" {
        return "error: failed to remove plugin ${name}: ${err}"
    }
    return "removed plugin ${name}"
}

fun update(name: str) -> str {
    if name == "" {
        return "usage: /plugins update <name>"
    }
    if not valid_plugin_name(name) {
        return "error: unsafe plugin name: ${name}"
    }
    let path = plugin_path(name)
    if path == "" or not is_dir(path) {
        return "no plugin named ${name}; /plugins list shows what is installed"
    }
    // plugin_source stores the url in name and the ref in description.
    let src = plugin_source(path)
    if src.name == "" {
        return "no recorded source for ${name}; remove it and add it again"
    }
    return install_plugin(src.name, src.description)
}

fun _add_count(parts: list[str], path: str, sub: str, label: str) {
    let n = _count(path, sub)
    if n > 0 {
        parts.push("${n} ${label}")
    }
    return
}

fun _count(path: str, sub: str) -> int {
    let d = "${path}/${sub}"
    if not is_dir(d) {
        return 0
    }
    return match list_dir(d) {
        case Ok(ns) { ns.len() }
        case Err(e) { 0 }
    }
}

// Remove a directory tree, clearing read-only attributes first on Windows
// so a plugin's git files do not block removal. See install._remove_tree.
fun _rmtree(path: str) -> str {
    var detail = ""
    if os_name() == "windows" {
        detail = _append_detail(
            detail,
            _run_remove("attrib", ["-r", "-s", "-h", "/s", "/d", "${path}\\*"]),
        )
        detail = _append_detail(detail, _run_remove("cmd", ["/c", "rmdir", "/s", "/q", path]))
    } else {
        detail = _append_detail(detail, _run_remove("rm", ["-rf", path]))
    }
    return removal_error(path, detail)
}

fun _run_remove(command: str, args: list[str]) -> str {
    return match run(command, args) {
        case Ok(o) { "" if o.code == 0 else _output_error(command, o) }
        case Err(e) { "${command} failed to start: ${e.message}" }
    }
}

fun _output_error(command: str, out: Output) -> str {
    var msg = out.stderr.trim()
    if msg == "" {
        msg = out.stdout.trim()
    }
    if msg == "" {
        msg = "exit ${out.code}"
    } else {
        msg = "${msg} (exit ${out.code})"
    }
    return "${command}: ${msg}"
}

fun _append_detail(existing: str, next: str) -> str {
    if next == "" {
        return existing
    }
    if existing == "" {
        return next
    }
    return "${existing}; ${next}"
}

fun removal_error(path: str, detail: str) -> str {
    if not is_dir(path) {
        return ""
    }
    if detail.trim() == "" {
        return "directory still exists after removal: ${path}"
    }
    return "directory still exists after removal: ${path}; ${detail.trim()}"
}
