// The application model: everything the UI renders and the update logic
// mutates. The conversation the model sees lives in the shared AgentState;
// this holds the display transcript and the UI's own state.

from "github.com/martian56/plumage/widgets/input" import TextInput
from "../agent/state" import AgentState
from "../ui/transcript" import Entry, AgentBlock, EntryLines, empty_entry_lines
from "../ui/selection" import Selection, no_selection
from "../ui/theme" import Theme
from "../ui/themes" import startup_theme
from "../ui/depth" import themed
from std.env import args
from "../config/sessions" import SessionMeta, new_session_id, begin_load_latest
from "../commands" import CmdInfo, builtin_commands, merge_infos
from "../agents/dir" import roots
from "../agents/commands" import load_commands, command_infos
from "../agents/settings" import settings_errors_from
from "../hooks/hooks" import drain_hook_notices
from "../config/config" import resolve_model, resolve_base, resolve_key, resolve_theme, save_model, rook_json_errors, resolve_budget_usd
from "../tools/permission_menu" import PermissionGrantState
from "../tools/mentions" import warm_files
from "./update_check" import begin_update_check

// The /model picker's data, built once and reused. `ids`/`labels`/`lower` are
// the whole catalog (labels index-aligned to ids, lower a lowercased id copy
// for search). `pick_ids`/`pick_labels` are the current filtered view the
// picker renders, recomputed only when the search query changes.
class ModelCatalog {
    ids: list[str]
    labels: list[str]
    lower: list[str]
    pick_ids: list[str]
    pick_labels: list[str]
}

fun empty_catalog() -> ModelCatalog {
    let ids: list[str] = []
    let labels: list[str] = []
    let lower: list[str] = []
    let pick_ids: list[str] = []
    let pick_labels: list[str] = []
    return ModelCatalog(
        ids: ids,
        labels: labels,
        lower: lower,
        pick_ids: pick_ids,
        pick_labels: pick_labels,
    )
}

class Chat {
    entries: list[Entry]
    // Per-entry rendered-line cache, index-aligned with entries. Kept aligned
    // by set_entry/replace_entries and the insert/remove helpers; padded by
    // ensure_cache_len before each render. cache_width/cache_theme are what it
    // was built for, so a resize or theme change invalidates it wholesale.
    line_cache: list[EntryLines]
    cache_width: int
    cache_theme: str
    entry: TextInput
    agent: AgentState
    // A turn is in flight (the goroutine is streaming).
    active: bool
    // The tool label awaiting approval, "" when none is pending, and the
    // diff preview shown under it.
    pending: str
    pending_detail: str
    // The model's question awaiting a pick, "" when none, with its options
    // and the highlighted one.
    question: str
    choices: list[str]
    choice_sel: int
    // The streaming reply's accumulated text and the transcript index of its
    // bubble (-1 when not streaming a bubble).
    stream_text: str
    cur_bubble: int
    tick: int
    elapsed: int
    word: str
    scroll_up: int
    armed: bool
    turns: int
    // Mouse text selection over the transcript, anchored to content lines so
    // it survives scrolling. tr_* is the transcript area and top line that the
    // last render used, so a mouse cell maps to a content line/column.
    sel: Selection
    tr_x: int
    tr_y: int
    tr_w: int
    tr_h: int
    tr_top: int
    // A brief status-bar flash (for example "copied") shown until this tick.
    flash: str
    flash_until: int
    // "provider/model" and the key for its provider ("" when none is set).
    model: str
    api_key: str
    // A custom endpoint, "" for the provider default.
    base_url: str
    // The /model picker overlay: open, the highlighted row (within the
    // filtered list), and the search bar.
    picking: bool
    pick_sel: int
    pick_input: TextInput
    // The model catalog, built once on first picker open and reused after.
    // Bundled into one struct so Chat keeps a single field for it (the GC
    // descriptor only tracks a struct's first 64 fields).
    catalog: ModelCatalog
    // The API-key entry overlay.
    entering_key: bool
    key_input: TextInput
    // The active palette; every view reads its styles from here.
    theme: Theme
    // The /theme picker overlay: open, the highlighted row, and the name to
    // restore on cancel (selection previews live).
    theme_picking: bool
    theme_sel: int
    theme_prev: str
    // Every command (built-ins then customs), loaded once at startup, for
    // the slash menu and /help.
    cmd_infos: list[CmdInfo]
    // The slash menu: the highlighted row, and whether esc dismissed it for
    // the current input.
    slash_sel: int
    slash_dismissed: bool
    // The /help overlay: open, and the highlighted command.
    help_open: bool
    help_sel: int
    // The /permissions panel: open, and the highlighted grant.
    permissions_open: bool
    permissions_sel: int
    permissions_items: list[PermissionGrantState]
    // Running subagent blocks in the transcript (name, header index, tool
    // count), so their rows group and collapse.
    open_agents: list[AgentBlock]
    // The /shells panel: open, the highlighted row, and the shell id whose
    // output pane is focused (0 while the list is showing).
    shells_open: bool
    shells_sel: int
    shells_focus: int
    // Plan mode: the model researches and proposes, mutating tools blocked.
    plan_mode: bool
    // The @-file picker: the current path matches, the highlighted row, and
    // whether esc dismissed it until the input changes.
    mention_matches: list[str]
    mention_sel: int
    mention_dismissed: bool
    // Session token totals, drained from the agent for the status bar.
    sess_prompt: int
    sess_completion: int
    // Persistence: the current session's id (its file on disk), and the
    // /sessions picker (open, the highlighted row, and the loaded list).
    session_id: str
    sessions_open: bool
    sessions_sel: int
    sessions_list: list[SessionMeta]
    // True while the background session scan runs, so the panel shows a loading
    // line instead of "no saved sessions" before the list arrives.
    sessions_loading: bool
    // True while a chosen session is being read off the UI thread, until _tick
    // applies the restored transcript and history.
    resuming: bool
    // The session's prompt-cache totals, for the discounted cost estimate.
    // At the end of the struct: these are plain Ints, and the runtime's GC
    // descriptor only tracks heap fields in the first 64 positions, so
    // non-heap fields go last.
    sess_cache_read: int
    sess_cache_write: int
    // The transcript's total line count last frame, so the view can keep the
    // window anchored while scrolled up as new output grows the total.
    last_total: int
    // Scrollback in the focused shell pane, in lines up from the live tail.
    shells_scroll: int
    // The session row armed for deletion (-1 when none): d arms, d again
    // deletes, any other key disarms.
    sessions_confirm: int
    // The transcript index of a running ! command's placeholder entry, -1
    // when no shell command is in flight.
    bang_at: int
    // The session spend ceiling in micro-dollars (0 when none is configured)
    // and whether its one-time warning already fired.
    budget_micros: int
    budget_warned: bool
    // The edit-a-previous-message picker (opened by double Esc): open, the
    // highlighted row, and the tick of the last bare Esc press.
    rewind_open: bool
    rewind_sel: int
    last_esc: int
    // The /sessions panel tab: 0 = this directory, 1 = all sessions.
    sessions_tab: int
}

fun chat_init() -> Chat {
    // Walk the project for the @-mention picker on a goroutine now, so the
    // first @ keystroke filters a ready list instead of stalling on the walk.
    warm_files()
    begin_update_check()
    // --continue reopens the most recent saved session: the listing and read
    // run off-thread and the tick pickup applies them, exactly like choosing
    // it in /sessions.
    let continue_last = _wants_continue()
    if continue_last {
        begin_load_latest()
    }
    let model = resolve_model()
    let rs = roots()
    let startup_notices = settings_errors_from(rs)
    let cfg_errors = rook_json_errors()
    var ci = 0
    while ci < cfg_errors.len() {
        startup_notices.push(cfg_errors[ci])
        ci = ci + 1
    }
    let hook_notices = drain_hook_notices()
    var i = 0
    while i < hook_notices.len() {
        startup_notices.push(hook_notices[i])
        i = i + 1
    }
    let entries = settings_error_entries(startup_notices)
    let line_cache: list[EntryLines] = []
    let open_agents: list[AgentBlock] = []
    let no_choices: list[str] = []
    let no_matches: list[str] = []
    let no_sessions: list[SessionMeta] = []
    let no_permissions: list[PermissionGrantState] = []
    return Chat(
        entries: entries,
        line_cache: line_cache,
        cache_width: 0,
        cache_theme: "",
        entry: TextInput.new(),
        agent: AgentState.new(),
        active: false,
        pending: "",
        pending_detail: "",
        question: "",
        choices: no_choices,
        choice_sel: 0,
        stream_text: "",
        cur_bubble: 0 - 1,
        tick: 0,
        elapsed: 0,
        word: "Thinking",
        scroll_up: 0,
        armed: false,
        turns: 0,
        sel: no_selection(),
        tr_x: 0,
        tr_y: 0,
        tr_w: 0,
        tr_h: 0,
        tr_top: 0,
        flash: "",
        flash_until: 0,
        model: model,
        api_key: resolve_key(model),
        base_url: resolve_base(),
        picking: false,
        pick_sel: 0,
        pick_input: TextInput.new(),
        catalog: empty_catalog(),
        entering_key: false,
        key_input: TextInput.new(),
        theme: themed(startup_theme(resolve_theme())),
        theme_picking: false,
        theme_sel: 0,
        theme_prev: "",
        cmd_infos: merge_infos(builtin_commands(), command_infos(load_commands(rs))),
        slash_sel: 0,
        slash_dismissed: false,
        help_open: false,
        help_sel: 0,
        permissions_open: false,
        permissions_sel: 0,
        permissions_items: no_permissions,
        open_agents: open_agents,
        shells_open: false,
        shells_sel: 0,
        shells_focus: 0,
        plan_mode: false,
        mention_matches: no_matches,
        mention_sel: 0,
        mention_dismissed: false,
        sess_prompt: 0,
        sess_completion: 0,
        session_id: new_session_id(),
        sessions_open: false,
        sessions_sel: 0,
        sessions_list: no_sessions,
        sessions_loading: false,
        resuming: continue_last,
        sess_cache_read: 0,
        sess_cache_write: 0,
        last_total: 0,
        shells_scroll: 0,
        sessions_confirm: 0 - 1,
        bang_at: 0 - 1,
        budget_micros: resolve_budget_usd() * 1000000,
        budget_warned: false,
        rewind_open: false,
        rewind_sel: 0,
        last_esc: 0 - 100,
        sessions_tab: 0,
    )
}

// Convert settings load errors into startup transcript notices.
fun settings_error_entries(errors: list[str]) -> list[Entry] {
    let out: list[Entry] = []
    var i = 0
    while i < errors.len() {
        out.push(Entry.Notice(errors[i]))
        i = i + 1
    }
    return out
}

// Adopt a newly chosen model: update the running config, resolve its key, and
// persist the choice so the next session remembers it.
fun set_model(m: Chat, model: str) -> str {
    apply_model(m, model)
    return save_model(model)
}

fun apply_model(m: Chat, model: str) {
    m.model = model
    m.api_key = resolve_key(model)
    return
}

// Pad the line cache to the number of entries, so appended entries (which go
// straight onto m.entries) get an invalid slot before the next render. Called
// on every render path and by the mutation helpers.
fun ensure_cache_len(m: Chat) {
    while m.line_cache.len() < m.entries.len() {
        m.line_cache.push(empty_entry_lines())
    }
    return
}

// Mark every cache slot invalid: used when the width or theme changes, so the
// whole transcript is re-wrapped once at the new size or palette.
fun invalidate_all_cache(m: Chat) {
    var i = 0
    while i < m.line_cache.len() {
        m.line_cache[i] = empty_entry_lines()
        i = i + 1
    }
    return
}

// Replace an entry in place and invalidate just its cache slot (the streaming
// bubble and a finishing agent header take this path).
fun set_entry(m: Chat, i: int, e: Entry) {
    m.entries[i] = e
    ensure_cache_len(m)
    if i >= 0 and i < m.line_cache.len() {
        m.line_cache[i] = empty_entry_lines()
    }
    return
}

// Swap the whole transcript (session resume, /clear) and reset the cache to a
// matching run of invalid slots.
fun replace_entries(m: Chat, es: list[Entry]) {
    m.entries = es
    let cache: list[EntryLines] = []
    var i = 0
    while i < es.len() {
        cache.push(empty_entry_lines())
        i = i + 1
    }
    m.line_cache = cache
    return
}

// Whether the command line asked to reopen the most recent session.
fun _wants_continue() -> bool {
    let a = args()
    var i = 0
    while i < a.len() {
        if a[i] == "--continue" or a[i] == "-c" {
            return true
        }
        i = i + 1
    }
    return false
}
