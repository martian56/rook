// Which model and theme to use, the model's API key, and how all three
// persist.
//
// Model resolution at startup (highest first): the --model flag, ROOK_MODEL,
// a project ./rook.json "model", the project .agents/settings.json, a global
// ~/.config/rook/rook.json "model", the global ~/.agents/settings.json, the
// last model picked in a previous session, then a built-in default. The
// theme and base_url resolve through the same chain (minus the flag).
//
// The API key for a provider comes from its environment variable, else from
// ~/.rook/auth.json (written when you enter a key with /key). A model whose
// provider has no key runs nothing until one is supplied.

import std.string
from std.env import get_env, has_env, args
from std.fs import read, write, exists, create_dir_all
from std.json import JsonValue, parse, stringify
from std.time import now_millis
from "github.com/martian56/aviary/jsonutil" import Obj, field, as_int_or
from "../agents/dir" import project_root, global_root
from "../agents/settings" import setting_str

// The model used when nothing else selects one. A "provider/model" string.
let DEFAULT_MODEL: str = "openrouter/anthropic/claude-sonnet-5"

class AuthUpdate {
    ok: bool
    text: str
    error: str
}

fun resolve_model() -> str {
    let a = args()
    var i = 0
    while i < a.len() {
        if a[i] == "--model" and i + 1 < a.len() {
            return a[i + 1]
        }
        i = i + 1
    }
    if has_env("ROOK_MODEL") {
        let v = get_env("ROOK_MODEL")
        if v != "" {
            return v
        }
    }
    let proj = _json_str(_read_opt("rook.json"), "model")
    if proj != "" {
        return proj
    }
    let ps = setting_str(project_root(), "model")
    if ps != "" {
        return ps
    }
    let h = _home()
    if h != "" {
        let glob = _json_str(_read_opt("${h}/.config/rook/rook.json"), "model")
        if glob != "" {
            return glob
        }
    }
    let gs = setting_str(global_root(), "model")
    if gs != "" {
        return gs
    }
    let last = last_used()
    if last != "" {
        return last
    }
    return DEFAULT_MODEL
}

// A custom OpenAI-compatible endpoint, from ROOK_BASE_URL, rook.json, or the
// .agents settings. Empty means use the provider's default endpoint.
fun resolve_base() -> str {
    if has_env("ROOK_BASE_URL") {
        let v = get_env("ROOK_BASE_URL")
        if v != "" {
            return v
        }
    }
    let proj = _json_str(_read_opt("rook.json"), "base_url")
    if proj != "" {
        return proj
    }
    let ps = setting_str(project_root(), "base_url")
    if ps != "" {
        return ps
    }
    let h = _home()
    if h != "" {
        let glob = _json_str(_read_opt("${h}/.config/rook/rook.json"), "base_url")
        if glob != "" {
            return glob
        }
    }
    return setting_str(global_root(), "base_url")
}

// The theme to start with: a project ./rook.json "theme", the project
// .agents settings, a global ~/.config/rook/rook.json "theme", the global
// .agents settings, the last theme picked in a previous session, else ""
// (the caller falls back to the default palette).
fun resolve_theme() -> str {
    let proj = _json_str(_read_opt("rook.json"), "theme")
    if proj != "" {
        return proj
    }
    let ps = setting_str(project_root(), "theme")
    if ps != "" {
        return ps
    }
    let h = _home()
    if h != "" {
        let glob = _json_str(_read_opt("${h}/.config/rook/rook.json"), "theme")
        if glob != "" {
            return glob
        }
    }
    let gs = setting_str(global_root(), "theme")
    if gs != "" {
        return gs
    }
    if h != "" {
        return _read_opt("${h}/.rook/last-theme").trim()
    }
    return ""
}

// Remember `name` as the theme for the next session.
fun save_theme(name: str) -> str {
    let h = _home()
    if h == "" {
        return "error: no home directory for ~/.rook/last-theme"
    }
    let dir = "${h}/.rook"
    var mkdir_err = ""
    match create_dir_all(dir) {
        case Ok(ok) {}
        case Err(e) {
            mkdir_err = "error: could not create ~/.rook: ${e.message}"
        }
    }
    if mkdir_err != "" {
        return mkdir_err
    }
    return match write("${dir}/last-theme", name) {
        case Ok(ok) { "" }
        case Err(e) { "error: could not write ~/.rook/last-theme: ${e.message}" }
    }
}

// The last model picked in a previous session, or "" when none was saved.
fun last_used() -> str {
    let p = _state_path()
    if p == "" {
        return ""
    }
    return _read_opt(p).trim()
}

// Remember `model` as the last-used choice for the next session.
fun save_model(model: str) -> str {
    let h = _home()
    if h == "" {
        return "error: no home directory for ~/.rook/last-model"
    }
    let dir = "${h}/.rook"
    var mkdir_err = ""
    match create_dir_all(dir) {
        case Ok(ok) {}
        case Err(e) {
            mkdir_err = "error: could not create ~/.rook: ${e.message}"
        }
    }
    if mkdir_err != "" {
        return mkdir_err
    }
    return match write("${dir}/last-model", model) {
        case Ok(ok) { "" }
        case Err(e) { "error: could not write ~/.rook/last-model: ${e.message}" }
    }
}

// The API key for a model's provider: its environment variable if set, else
// the stored key from ~/.rook/auth.json, else "".
fun resolve_key(model: str) -> str {
    let p = provider_of(model)
    let env = key_env(p)
    if env != "" and has_env(env) {
        let v = get_env(env)
        if v != "" {
            return v
        }
    }
    return stored_key(p)
}

fun stored_key(provider: str) -> str {
    if provider == "" {
        return ""
    }
    return _json_str(_read_opt(_auth_path()), provider)
}

// Store `key` for `provider` in ~/.rook/auth.json, merging with any keys
// already saved for other providers.
fun save_key(provider: str, key: str) -> str {
    let h = _home()
    if h == "" {
        return "error: no home directory for ~/.rook/auth.json"
    }
    let dir = "${h}/.rook"
    var mkdir_err = ""
    match create_dir_all(dir) {
        case Ok(ok) {}
        case Err(e) {
            mkdir_err = "error: could not create ~/.rook: ${e.message}"
        }
    }
    if mkdir_err != "" {
        return mkdir_err
    }
    return save_key_to_path("${dir}/auth.json", provider, key)
}

// Whether a model can run: its provider has a key, or accepts a keyless
// connection such as Ollama and a custom OpenAI-compatible endpoint.
fun key_present(model: str) -> bool {
    if _key_optional(provider_of(model)) {
        return true
    }
    return resolve_key(model) != ""
}

// Whether a model is missing the key it needs.
fun key_needed(model: str) -> bool {
    if _key_optional(provider_of(model)) {
        return false
    }
    return resolve_key(model) == ""
}

// key_needed using an already-resolved key, so the send path checks the model's
// loaded key (m.api_key) instead of re-reading auth.json on every message.
fun key_needed_with(model: str, key: str) -> bool {
    if _key_optional(provider_of(model)) {
        return false
    }
    return key == ""
}

// The provider part of a "provider/model" string, or "" when malformed.
fun provider_of(model: str) -> str {
    let slash = model.index_of("/")
    if slash < 0 {
        return ""
    }
    return model.substring(0, slash)
}

// The environment variable holding a provider's API key, or "" when the
// provider needs none (Ollama) or is unknown.
fun key_env(provider: str) -> str {
    if provider == "openai" {
        return "OPENAI_API_KEY"
    }
    if provider == "anthropic" or provider == "claude" {
        return "ANTHROPIC_API_KEY"
    }
    if provider == "gemini" or provider == "google" {
        return "GEMINI_API_KEY"
    }
    if provider == "groq" {
        return "GROQ_API_KEY"
    }
    if provider == "mistral" {
        return "MISTRAL_API_KEY"
    }
    if provider == "deepseek" {
        return "DEEPSEEK_API_KEY"
    }
    if provider == "openrouter" {
        return "OPENROUTER_API_KEY"
    }
    if provider == "cohere" {
        return "COHERE_API_KEY"
    }
    if provider == "xai" or provider == "grok" {
        return "XAI_API_KEY"
    }
    if provider == "together" {
        return "TOGETHER_API_KEY"
    }
    if provider == "fireworks" {
        return "FIREWORKS_API_KEY"
    }
    if provider == "perplexity" {
        return "PERPLEXITY_API_KEY"
    }
    if provider == "deepinfra" {
        return "DEEPINFRA_API_KEY"
    }
    if provider == "nebius" {
        return "NEBIUS_API_KEY"
    }
    if provider == "moonshot" {
        return "MOONSHOT_API_KEY"
    }
    if provider == "sakana" {
        return "SAKANA_API_KEY"
    }
    if provider == "azure" {
        return "AZURE_API_KEY"
    }
    if provider == "custom" {
        return "AVIARY_API_KEY"
    }
    return ""
}

fun _key_optional(provider: str) -> bool {
    return provider == "ollama" or provider == "custom"
}

// Whether `provider` runs without an API key (a local Ollama or a custom
// endpoint). Public and pure, so the UI can decide whether to nag about a
// missing key without re-reading auth.json.
fun key_optional(provider: str) -> bool {
    return _key_optional(provider)
}

fun _home() -> str {
    if has_env("HOME") {
        let h = get_env("HOME")
        if h != "" {
            return h
        }
    }
    if has_env("USERPROFILE") {
        return get_env("USERPROFILE")
    }
    return ""
}

fun _state_path() -> str {
    let h = _home()
    if h == "" {
        return ""
    }
    return "${h}/.rook/last-model"
}

fun _auth_path() -> str {
    let h = _home()
    if h == "" {
        return ""
    }
    return "${h}/.rook/auth.json"
}

// Read a file, returning "" when it is missing or unreadable.
fun _read_opt(path: str) -> str {
    if path == "" {
        return ""
    }
    if not exists(path) {
        return ""
    }
    return match read(path) {
        case Ok(s) { s }
        case Err(e) { "" }
    }
}

fun save_key_to_path(path: str, provider: str, key: str) -> str {
    var existing = ""
    if exists(path) {
        var read_err = ""
        match read(path) {
            case Ok(s) {
                existing = s
            }
            case Err(e) {
                read_err = "error: could not read ${path}: ${e.message}"
            }
        }
        if read_err != "" {
            return read_err
        }
    }
    let updated = auth_with_key(existing, provider, key)
    if not updated.ok {
        return updated.error
    }
    return match write(path, updated.text) {
        case Ok(ok) { "" }
        case Err(e) { "error: could not write ${path}: ${e.message}" }
    }
}

// Rebuild the auth JSON object with `provider` set to `key`, preserving any
// other providers already present. Malformed existing JSON is an error so a
// save cannot silently replace the whole auth file.
fun auth_with_key(existing: str, provider: str, key: str) -> AuthUpdate {
    if provider == "" {
        return AuthUpdate(ok: false, text: "", error: "error: no provider selected")
    }
    var obj = Obj.new()
    var parse_err = ""
    if existing.trim() != "" {
        match parse(existing) {
            case Ok(j) {
                let ks = j.keys()
                var i = 0
                while i < ks.len() {
                    if ks[i] != provider {
                        obj = obj.str(ks[i], _field_str(j, ks[i]))
                    }
                    i = i + 1
                }
            }
            case Err(e) {
                parse_err = "error: ~/.rook/auth.json is not valid JSON; key not saved"
            }
        }
    }
    if parse_err != "" {
        return AuthUpdate(ok: false, text: "", error: parse_err)
    }
    obj = obj.str(provider, key)
    return AuthUpdate(ok: true, text: stringify(obj.build()), error: "")
}

// rook.json "context_window" (project first, then global), or 0 when unset.
// Lets a user give the window of a model rook does not know.
fun context_window_override() -> int {
    for path in ["rook.json", "${_home()}/.config/rook/rook.json"] {
        let text = _read_opt(path)
        if text.trim() == "" {
            continue
        }
        match parse(text) {
            case Ok(j) {
                let n = as_int_or(field(j, "context_window"), 0)
                if n > 0 {
                    return n
                }
            }
            case Err(e) {}
        }
    }
    return 0
}

// A string field from a JSON config document, or "" when absent.
fun _json_str(text: str, key: str) -> str {
    if text.trim() == "" {
        return ""
    }
    return match parse(text) {
        case Ok(j) { _field_str(j, key) }
        case Err(e) { "" }
    }
}

// Parse errors in the rook.json config files, as startup notices, so a typo
// does not silently fall back to defaults the way it did before (settings.json
// errors already surface this way). Checks the project ./rook.json and the
// global ~/.config/rook/rook.json.
fun rook_json_errors() -> list[str] {
    let out: list[str] = []
    _check_rook_json("rook.json", out)
    let h = _home()
    if h != "" {
        _check_rook_json("${h}/.config/rook/rook.json", out)
    }
    return out
}

fun _check_rook_json(path: str, out: list[str]) {
    let text = _read_opt(path)
    if text.trim() == "" {
        return
    }
    match parse(text) {
        case Ok(j) {}
        case Err(e) { out.push("config error: invalid JSON in ${path}, ignored: ${e.message}") }
    }
    return
}

fun _field_str(j: JsonValue, key: str) -> str {
    return match j.get(key) {
        case Some(v) { _as_str(v) }
        case None { "" }
    }
}

fun _as_str(v: JsonValue) -> str {
    return match v.as_string() {
        case Some(s) { s }
        case None { "" }
    }
}

// Where the resolved model came from, mirroring resolve_model's chain, so
// /status can say which layer won.
fun model_source() -> str {
    let a = args()
    var i = 0
    while i < a.len() {
        if a[i] == "--model" and i + 1 < a.len() {
            return "the --model flag"
        }
        i = i + 1
    }
    if has_env("ROOK_MODEL") and get_env("ROOK_MODEL") != "" {
        return "ROOK_MODEL"
    }
    if _json_str(_read_opt("rook.json"), "model") != "" {
        return "./rook.json"
    }
    if setting_str(project_root(), "model") != "" {
        return "the project .agents settings"
    }
    let h = _home()
    if h != "" and _json_str(_read_opt("${h}/.config/rook/rook.json"), "model") != "" {
        return "~/.config/rook/rook.json"
    }
    if setting_str(global_root(), "model") != "" {
        return "the global .agents settings"
    }
    if last_used() != "" {
        return "the last session's pick"
    }
    return "the built-in default"
}

// Where the endpoint override came from, "" meaning the provider default.
fun base_source() -> str {
    if has_env("ROOK_BASE_URL") and get_env("ROOK_BASE_URL") != "" {
        return "ROOK_BASE_URL"
    }
    if _json_str(_read_opt("rook.json"), "base_url") != "" {
        return "./rook.json"
    }
    if setting_str(project_root(), "base_url") != "" {
        return "the project .agents settings"
    }
    let h = _home()
    if h != "" and _json_str(_read_opt("${h}/.config/rook/rook.json"), "base_url") != "" {
        return "~/.config/rook/rook.json"
    }
    if setting_str(global_root(), "base_url") != "" {
        return "the global .agents settings"
    }
    return ""
}

// Where the theme came from, mirroring resolve_theme.
fun theme_source() -> str {
    if _json_str(_read_opt("rook.json"), "theme") != "" {
        return "./rook.json"
    }
    if setting_str(project_root(), "theme") != "" {
        return "the project .agents settings"
    }
    let h = _home()
    if h != "" and _json_str(_read_opt("${h}/.config/rook/rook.json"), "theme") != "" {
        return "~/.config/rook/rook.json"
    }
    if setting_str(global_root(), "theme") != "" {
        return "the global .agents settings"
    }
    if h != "" and _read_opt("${h}/.rook/last-theme").trim() != "" {
        return "the last session's pick"
    }
    return "the default palette"
}

// Where the model's API key comes from: its environment variable, the stored
// auth file, or nowhere.
fun key_source(model: str) -> str {
    let provider = provider_of(model)
    if _key_optional(provider) {
        return "not required for ${provider}"
    }
    let env = key_env(provider)
    if env != "" and has_env(env) and get_env(env) != "" {
        return "the ${env} environment variable"
    }
    if stored_key(provider) != "" {
        return "~/.rook/auth.json"
    }
    return "nowhere: no key is set"
}

// The session spend ceiling in whole dollars, 0 when none is configured.
// From "budget_usd" in ./rook.json, then the global rook.json.
fun resolve_budget_usd() -> int {
    let proj = _budget_of(_read_opt("rook.json"))
    if proj > 0 {
        return proj
    }
    let h = _home()
    if h == "" {
        return 0
    }
    return _budget_of(_read_opt("${h}/.config/rook/rook.json"))
}

fun _budget_of(text: str) -> int {
    if text == "" {
        return 0
    }
    return match parse(text) {
        case Ok(j) { as_int_or(field(j, "budget_usd"), 0) }
        case Err(e) { 0 }
    }
}

// Append a line to ~/.rook/debug.log when ROOK_DEBUG is set, for provider
// failures where the friendly message is not enough. Best effort.
fun debug_log(line: str) {
    if not has_env("ROOK_DEBUG") {
        return
    }
    let h = _home()
    if h == "" {
        return
    }
    create_dir_all("${h}/.rook")
    let path = "${h}/.rook/debug.log"
    let existing = _read_opt(path)
    match write(path, "${existing}[${now_millis()}] ${line}\n") {
        case Ok(ok) {}
        case Err(e) {}
    }
    return
}

// Whether rook signs its work: a Co-Authored-By trailer on commits it makes
// and a generated-by line on pull requests it opens. On by default;
// "attribution": false in ./rook.json (or the global rook.json) turns it
// off for repositories whose conventions forbid it.
fun attribution_enabled() -> bool {
    let proj = _attribution_of(_read_opt("rook.json"))
    if proj != 0 {
        return proj == 1
    }
    let h = _home()
    if h != "" {
        let glob = _attribution_of(_read_opt("${h}/.config/rook/rook.json"))
        if glob != 0 {
            return glob == 1
        }
    }
    return true
}

// 0 unset, 1 enabled, 2 disabled. Split out and importable so the parsing
// is testable without touching real config files.
fun _attribution_of(text: str) -> int {
    if text == "" {
        return 0
    }
    return match parse(text) {
        case Ok(j) {
            match field(j, "attribution").as_bool() {
                case Some(b) { _flag_of(b) }
                case None { 0 }
            }
        }
        case Err(e) { 0 }
    }
}

fun _flag_of(b: bool) -> int {
    if b {
        return 1
    }
    return 2
}
